<section class="page-shell familias-layout" data-page="assistidos-lista">
  <nav class="familias-breadcrumb" aria-label="Trilha de navegacao">
    <a class="familias-breadcrumb-link" href="/painel">Painel</a>
    <span class="familias-breadcrumb-sep" aria-hidden="true">/</span>
    <span class="familias-breadcrumb-current">Assistidos</span>
  </nav>

  <header class="familias-header familias-hero card-elevated">
    <div class="familias-hero-main">
      <p class="familias-overline">Cadastro central</p>
      <h1 class="familias-title">Assistidos</h1>
      <p class="familias-subtitle">Gestão individual dos assistidos e seus registros de acompanhamento.</p>
      <div class="familias-hero-metrics">
        <article class="familias-hero-metric">
          <span>Resultados</span>
          <strong id="assistidos-total-chip">0</strong>
        </article>
        <article class="familias-hero-metric">
          <span>Ativos</span>
          <strong id="assistidos-active-chip">0</strong>
        </article>
      </div>
    </div>
    <div class="familias-header-actions">
      <a href="/painel" class="btn btn-muted">Voltar ao Painel</a>
      <% if (viewFlags?.canCreate) { %>
        <a href="/assistidos/novo" class="btn btn-primary">Novo Assistido</a>
      <% } %>
    </div>
  </header>

  <section class="familias-filtros card-elevated">
    <div class="section-title-wrap">
      <h2 class="section-title">Encontrar assistido</h2>
      <p class="section-subtitle">Refine por nome, CPF, cidade ou status.</p>
    </div>
    <form id="assistidos-filtro-form" class="filtro-grid">
      <label class="field-wrap">
        <span class="input-label">Busca geral</span>
        <input class="input-control" type="text" name="busca" placeholder="Nome, CPF, telefone, email..." value="<%= filtros?.busca || '' %>" />
      </label>
      <label class="field-wrap">
        <span class="input-label">Status</span>
        <select class="input-control" name="status">
          <% const stAtual = filtros?.status || ''; %>
          <option value="">Todos</option>
          <option value="ativo"      <%= stAtual==='ativo'?'selected':'' %>>Ativo</option>
          <option value="rascunho"   <%= stAtual==='rascunho'?'selected':'' %>>Rascunho</option>
          <option value="em_analise" <%= stAtual==='em_analise'?'selected':'' %>>Em análise</option>
          <option value="inativo"    <%= stAtual==='inativo'?'selected':'' %>>Inativo</option>
        </select>
      </label>
      <label class="field-wrap">
        <span class="input-label">Faixa etária</span>
        <select class="input-control" name="faixaEtaria">
          <% const feAtual = filtros?.faixaEtaria || ''; %>
          <option value="">Todas</option>
          <option value="crianca"    <%= feAtual==='crianca'?'selected':'' %>>Criança</option>
          <option value="adolescente" <%= feAtual==='adolescente'?'selected':'' %>>Adolescente</option>
          <option value="adulto"     <%= feAtual==='adulto'?'selected':'' %>>Adulto</option>
          <option value="idoso"      <%= feAtual==='idoso'?'selected':'' %>>Idoso</option>
        </select>
      </label>
      <label class="field-wrap">
        <span class="input-label">Cidade</span>
        <input class="input-control" type="text" name="cidade" placeholder="Cidade" value="<%= filtros?.cidade || '' %>" />
      </label>
      <label class="field-wrap">
        <span class="input-label">Itens por página</span>
        <select class="input-control" name="limit">
          <% const limAtual = Number(filtros?.limit || 10); %>
          <option value="10"  <%= limAtual===10?'selected':'' %>>10</option>
          <option value="20"  <%= limAtual===20?'selected':'' %>>20</option>
          <option value="50"  <%= limAtual===50?'selected':'' %>>50</option>
          <option value="100" <%= limAtual===100?'selected':'' %>>100</option>
        </select>
      </label>
      <div class="filtro-actions">
        <button class="btn btn-primary" type="submit">Aplicar</button>
        <button class="btn btn-muted" type="button" id="assistidos-limpar-filtros">Limpar</button>
      </div>
    </form>
  </section>

  <section class="familias-listagem card-elevated">
    <div class="listagem-head">
      <div>
        <h2 class="section-title">Base de assistidos</h2>
        <p class="section-subtitle">Clique em um assistido para acessar a ficha completa.</p>
      </div>
      <span class="badge-soft" id="assistidos-count">0 encontrados</span>
    </div>

    <div class="table-responsive">
      <table class="familias-table">
        <thead>
          <tr>
            <th>Nome</th>
            <th>CPF</th>
            <th>Contato</th>
            <th>Faixa etária</th>
            <th>Cidade/UF</th>
            <th>Status</th>
            <th>Atualização</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody id="assistidos-table-body">
          <tr><td colspan="8">Carregando...</td></tr>
        </tbody>
      </table>
    </div>

    <nav id="assistidos-paginacao" class="paginacao-wrap"></nav>
  </section>
</section>

<script <%- typeof renderCspNonceAttr === "function" ? renderCspNonceAttr() : "" %> id="assistidos-initial" type="application/json"><%- serializeForInlineScript(filtros || {}) %></script>
<script <%- typeof renderCspNonceAttr === "function" ? renderCspNonceAttr() : "" %> id="assistidos-view-flags" type="application/json"><%- serializeForInlineScript(viewFlags || {}) %></script>
