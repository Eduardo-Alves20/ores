<%
  var _initials = (assistido?.nome || "A")
    .trim().split(/\s+/).filter(Boolean).slice(0, 2).map(function(w){ return w[0].toUpperCase(); }).join("");
%>

<section class="page-shell familias-layout" data-page="assistido-detalhe" data-assistido-id="<%= assistido._id %>">

  <nav class="ficha-breadcrumb" aria-label="Trilha de navegacao">
    <a class="ficha-breadcrumb-back" href="/assistidos">
      <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
      <span>Voltar para assistidos</span>
    </a>
  </nav>

  <header class="ficha-header card-elevated">
    <div class="ficha-header-identity">
      <div class="ficha-avatar" aria-hidden="true">
        <span class="ficha-avatar-letters"><%= _initials %></span>
      </div>
      <div class="ficha-identity-meta">
        <h1 class="ficha-identity-name"><%= assistido?.nome || "Assistido" %></h1>
        <div class="ficha-identity-tags">
          <span class="badge-soft <%= assistido?.status === 'ativo' ? '' : 'badge-soft-muted' %>">
            <%= { ativo: 'Ativo', rascunho: 'Rascunho', em_analise: 'Em análise', inativo: 'Inativo', cancelado: 'Cancelado' }[assistido?.status] || assistido?.status %>
          </span>
          <% if (assistido?.faixaEtaria) { %>
            <span class="ficha-identity-login"><%= { crianca:'Criança', adolescente:'Adolescente', adulto:'Adulto', idoso:'Idoso' }[assistido.faixaEtaria] || assistido.faixaEtaria %></span>
          <% } %>
          <span class="ficha-identity-date"><%= assistido?.telefonePrincipal || "" %></span>
        </div>
      </div>
    </div>
    <div class="ficha-header-actions">
      <% if (viewFlags?.canUpdate) { %>
        <a href="/assistidos/<%= assistido._id %>/editar" class="ficha-edit-btn" title="Editar assistido" aria-label="Editar assistido">
          <i class="fa-solid fa-pen" aria-hidden="true"></i>
        </a>
      <% } %>
    </div>
  </header>

  <div class="card-elevated" style="padding:24px">
    <div class="form-grid">
      <div class="field-wrap span-2">
        <span class="input-label">CPF</span>
        <p><%= assistido?.cpf || '—' %></p>
      </div>
      <div class="field-wrap span-2">
        <span class="input-label">RG</span>
        <p><%= assistido?.rg || '—' %></p>
      </div>
      <div class="field-wrap span-2">
        <span class="input-label">Data de nascimento</span>
        <p><%= assistido?.dataNascimento ? new Date(assistido.dataNascimento).toLocaleDateString('pt-BR') : '—' %></p>
      </div>
      <div class="field-wrap span-2">
        <span class="input-label">E-mail</span>
        <p><%= assistido?.email || '—' %></p>
      </div>
      <div class="field-wrap span-2">
        <span class="input-label">Telefone principal</span>
        <p><%= assistido?.telefonePrincipal || '—' %></p>
      </div>
      <div class="field-wrap span-2">
        <span class="input-label">Telefone secundário</span>
        <p><%= assistido?.telefoneSecundario || '—' %></p>
      </div>
      <div class="field-wrap span-4">
        <span class="input-label">Endereço</span>
        <p>
          <% var end = assistido?.endereco; %>
          <% if (end && (end.logradouro || end.cidade)) { %>
            <%= [end.logradouro, end.numero, end.complemento, end.bairro, end.cidade, end.estado].filter(Boolean).join(', ') %>
          <% } else { %>—<% } %>
        </p>
      </div>
      <% if (assistido?.observacoes) { %>
        <div class="field-wrap span-4">
          <span class="input-label">Observações</span>
          <p><%= assistido.observacoes %></p>
        </div>
      <% } %>
    </div>

    <div style="margin-top:24px;display:flex;gap:8px">
      <% if (viewFlags?.canUpdate) { %>
        <a href="/assistidos/<%= assistido._id %>/editar" class="btn btn-primary">Editar cadastro</a>
      <% } %>
      <a href="/assistidos" class="btn btn-muted">Voltar</a>
    </div>
  </div>

  <% if (viewFlags?.canAtendView) { %>
  <div class="card-elevated" style="padding:24px;margin-top:24px" data-atendimentos-section>
    <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:16px">
      <h2 class="section-title" style="margin:0">Histórico de atendimentos</h2>
      <% if (viewFlags?.canAtendCreate) { %>
        <button type="button" class="btn btn-primary" id="atendimento-novo-btn">Registrar atendimento</button>
      <% } %>
    </div>

    <% if (viewFlags?.canAtendCreate) { %>
    <form id="atendimento-form" class="card-elevated" style="padding:18px;margin-bottom:18px;display:none">
      <input type="hidden" name="atendimentoId" value="" />
      <div class="form-grid">
        <label class="field-wrap span-2">
          <span class="input-label">Tipo</span>
          <select class="input-control" name="tipo">
            <option value="presencial">Presencial</option>
            <option value="ligacao">Ligação</option>
            <option value="whatsapp">WhatsApp</option>
            <option value="mensagem">Mensagem</option>
            <option value="videochamada">Videochamada</option>
            <option value="outro">Outro</option>
          </select>
        </label>
        <label class="field-wrap span-2">
          <span class="input-label">Data e hora</span>
          <input class="input-control" type="datetime-local" name="dataHora" />
        </label>
        <label class="field-wrap span-4">
          <span class="input-label">Resumo *</span>
          <textarea class="input-control" name="resumo" rows="3" placeholder="O que foi tratado neste atendimento"></textarea>
        </label>
        <label class="field-wrap span-4">
          <span class="input-label">Próximos passos</span>
          <textarea class="input-control" name="proximosPassos" rows="2"></textarea>
        </label>
        <label class="field-wrap span-2">
          <span class="input-label">Visibilidade</span>
          <select class="input-control" name="visibilityScope">
            <option value="care_team">Equipe de cuidado</option>
            <option value="owner_only">Somente eu</option>
          </select>
        </label>
        <label class="field-wrap span-2">
          <span class="input-label">Notas privadas (só você vê)</span>
          <textarea class="input-control" name="notasPrivadas" rows="2"></textarea>
        </label>
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:14px">
        <button type="button" class="btn btn-muted" id="atendimento-cancelar-btn">Cancelar</button>
        <button type="submit" class="btn btn-primary" id="atendimento-salvar-btn">Salvar atendimento</button>
      </div>
    </form>
    <% } %>

    <div id="atendimentos-lista"><p style="color:var(--text-soft)">Carregando atendimentos…</p></div>
  </div>
  <% } %>

  <script
    <%- typeof renderCspNonceAttr === "function" ? renderCspNonceAttr() : "" %>
    id="assistido-detalhe-flags"
    type="application/json"
  ><%- serializeForInlineScript(viewFlags || {}) %></script>

</section>
