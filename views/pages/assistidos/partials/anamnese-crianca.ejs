<% var familia = locals.familia || locals.assistido || {}; %>
<div class="form-subsection">
  <h3 class="form-subsection-title">
    <span class="form-subsection-icon" style="background:#eef6ff;color:#1d4ed8"><i class="fa-solid fa-child-reaching" aria-hidden="true"></i></span>
    Anamnese - Crianca
  </h3>
  <div class="form-grid">
    <label class="field-wrap span-2">
      <span class="input-label">Nome do(a) paciente</span>
      <input class="input-control" type="text" name="campoExtra_crianca_nome_paciente" value="<%= familia?.camposExtras?.crianca_nome_paciente || '' %>" data-custom-field-key="crianca_nome_paciente" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Data da entrevista</span>
      <input class="input-control" type="date" name="campoExtra_crianca_data_entrevista" value="<%= familia?.camposExtras?.crianca_data_entrevista || '' %>" data-custom-field-key="crianca_data_entrevista" data-custom-field-type="data" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Entrevista realizada com</span>
      <input class="input-control" type="text" name="campoExtra_crianca_entrevista_realizada_com" value="<%= familia?.camposExtras?.crianca_entrevista_realizada_com || '' %>" data-custom-field-key="crianca_entrevista_realizada_com" data-custom-field-type="texto" />
    </label>
  </div>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title">
    <span class="form-subsection-icon" style="background:#fef3f2;color:#e64b3b"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i></span>
    Queixa
  </h3>
  <div class="form-grid">
    <label class="field-wrap span-4">
      <span class="input-label">Qual o motivo do atendimento?</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_queixa_motivo" rows="3" data-custom-field-key="crianca_queixa_motivo" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_queixa_motivo || '' %></textarea>
    </label>
    <label class="field-wrap span-2">
      <span class="input-label">Esteve ou esta em atendimento com outros profissionais? Qual(s)?</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_queixa_outros_profissionais" rows="3" data-custom-field-key="crianca_queixa_outros_profissionais" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_queixa_outros_profissionais || '' %></textarea>
    </label>
    <label class="field-wrap span-2">
      <span class="input-label">Observacoes da queixa</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_queixa_obs" rows="3" data-custom-field-key="crianca_queixa_obs" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_queixa_obs || '' %></textarea>
    </label>
  </div>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title">
    <span class="form-subsection-icon" style="background:#f0f7fc;color:#1C5D85"><i class="fa-solid fa-person-pregnant" aria-hidden="true"></i></span>
    Historico de vida I - Gravidez
  </h3>
  <div class="form-grid">
    <label class="field-wrap span-2">
      <span class="input-label">Como era composta a familia na epoca da concepcao?</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_gravidez_familia_concepcao" rows="2" data-custom-field-key="crianca_gravidez_familia_concepcao" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_gravidez_familia_concepcao || '' %></textarea>
    </label>
    <label class="field-wrap">
      <span class="input-label">Idade da mae na epoca</span>
      <input class="input-control" type="text" name="campoExtra_crianca_gravidez_idade_mae" value="<%= familia?.camposExtras?.crianca_gravidez_idade_mae || '' %>" data-custom-field-key="crianca_gravidez_idade_mae" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Idade do pai na epoca</span>
      <input class="input-control" type="text" name="campoExtra_crianca_gravidez_idade_pai" value="<%= familia?.camposExtras?.crianca_gravidez_idade_pai || '' %>" data-custom-field-key="crianca_gravidez_idade_pai" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap span-2">
      <span class="input-label">Como foi a aceitacao das familias?</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_gravidez_aceitacao_familias" rows="2" data-custom-field-key="crianca_gravidez_aceitacao_familias" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_gravidez_aceitacao_familias || '' %></textarea>
    </label>
    <label class="field-wrap">
      <span class="input-label">A gravidez foi planejada? (sim/nao)</span>
      <input class="input-control" type="text" name="campoExtra_crianca_gravidez_planejada" value="<%= familia?.camposExtras?.crianca_gravidez_planejada || '' %>" data-custom-field-key="crianca_gravidez_planejada" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Fez tratamento pre-natal? (sim/nao)</span>
      <input class="input-control" type="text" name="campoExtra_crianca_gravidez_prenatal" value="<%= familia?.camposExtras?.crianca_gravidez_prenatal || '' %>" data-custom-field-key="crianca_gravidez_prenatal" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Sofreu acidentes/quedas? (sim/nao)</span>
      <input class="input-control" type="text" name="campoExtra_crianca_gravidez_acidentes" value="<%= familia?.camposExtras?.crianca_gravidez_acidentes || '' %>" data-custom-field-key="crianca_gravidez_acidentes" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap span-2">
      <span class="input-label">Teve alguma doenca na gestacao? (rubeola/toxoplasmose/sifilis/outra)</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_gravidez_doenca_gestacao" rows="2" data-custom-field-key="crianca_gravidez_doenca_gestacao" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_gravidez_doenca_gestacao || '' %></textarea>
    </label>
    <label class="field-wrap">
      <span class="input-label">Ja tinham outros filhos? (sim/nao). Quais?</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_gravidez_outros_filhos" rows="2" data-custom-field-key="crianca_gravidez_outros_filhos" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_gravidez_outros_filhos || '' %></textarea>
    </label>
    <label class="field-wrap span-3">
      <span class="input-label">Doenca hereditaria no casal ou familia?</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_gravidez_doenca_hereditaria" rows="2" data-custom-field-key="crianca_gravidez_doenca_hereditaria" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_gravidez_doenca_hereditaria || '' %></textarea>
    </label>
  </div>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title">
    <span class="form-subsection-icon" style="background:#fff8f0;color:#d97706"><i class="fa-solid fa-baby" aria-hidden="true"></i></span>
    Historico de vida II - Parto
  </h3>
  <div class="form-grid">
    <label class="field-wrap">
      <span class="input-label">Tipo de parto (cesareo/normal/outros)</span>
      <input class="input-control" type="text" name="campoExtra_crianca_parto_tipo" value="<%= familia?.camposExtras?.crianca_parto_tipo || '' %>" data-custom-field-key="crianca_parto_tipo" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Peso ao nascer</span>
      <input class="input-control" type="text" name="campoExtra_crianca_parto_peso" value="<%= familia?.camposExtras?.crianca_parto_peso || '' %>" data-custom-field-key="crianca_parto_peso" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Comprimento ao nascer</span>
      <input class="input-control" type="text" name="campoExtra_crianca_parto_comprimento" value="<%= familia?.camposExtras?.crianca_parto_comprimento || '' %>" data-custom-field-key="crianca_parto_comprimento" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Teve ictericia? (sim/nao)</span>
      <input class="input-control" type="text" name="campoExtra_crianca_parto_ictericia" value="<%= familia?.camposExtras?.crianca_parto_ictericia || '' %>" data-custom-field-key="crianca_parto_ictericia" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap span-2">
      <span class="input-label">Algum problema no parto? (sim/nao) Qual?</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_parto_problema" rows="2" data-custom-field-key="crianca_parto_problema" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_parto_problema || '' %></textarea>
    </label>
    <label class="field-wrap">
      <span class="input-label">Nasceu prematuro/esbranquicado/cianotico?</span>
      <input class="input-control" type="text" name="campoExtra_crianca_parto_nasceu_como" value="<%= familia?.camposExtras?.crianca_parto_nasceu_como || '' %>" data-custom-field-key="crianca_parto_nasceu_como" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Ficou na incubadora? Quanto tempo?</span>
      <input class="input-control" type="text" name="campoExtra_crianca_parto_incubadora" value="<%= familia?.camposExtras?.crianca_parto_incubadora || '' %>" data-custom-field-key="crianca_parto_incubadora" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap span-4">
      <span class="input-label">Outras informacoes do parto</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_parto_outras_infos" rows="2" data-custom-field-key="crianca_parto_outras_infos" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_parto_outras_infos || '' %></textarea>
    </label>
  </div>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title">
    <span class="form-subsection-icon" style="background:#f0fdf4;color:#16a34a"><i class="fa-solid fa-utensils" aria-hidden="true"></i></span>
    Historico de vida III - Alimentacao
  </h3>
  <div class="form-grid">
    <label class="field-wrap">
      <span class="input-label">Mamou no seio? Ate que idade?</span>
      <input class="input-control" type="text" name="campoExtra_crianca_alimentacao_seio" value="<%= familia?.camposExtras?.crianca_alimentacao_seio || '' %>" data-custom-field-key="crianca_alimentacao_seio" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap span-3">
      <span class="input-label">Como a mae se sentia ao amamentar?</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_alimentacao_amamentar_sentimento" rows="2" data-custom-field-key="crianca_alimentacao_amamentar_sentimento" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_alimentacao_amamentar_sentimento || '' %></textarea>
    </label>
    <label class="field-wrap">
      <span class="input-label">Aceitou alimentacao pastosa? (sim/nao)</span>
      <input class="input-control" type="text" name="campoExtra_crianca_alimentacao_pastosa" value="<%= familia?.camposExtras?.crianca_alimentacao_pastosa || '' %>" data-custom-field-key="crianca_alimentacao_pastosa" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Aceitou alimentacao solida? (sim/nao)</span>
      <input class="input-control" type="text" name="campoExtra_crianca_alimentacao_solida" value="<%= familia?.camposExtras?.crianca_alimentacao_solida || '' %>" data-custom-field-key="crianca_alimentacao_solida" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap">
      <span class="input-label">Usou copo? (sim/nao)</span>
      <input class="input-control" type="text" name="campoExtra_crianca_alimentacao_copo" value="<%= familia?.camposExtras?.crianca_alimentacao_copo || '' %>" data-custom-field-key="crianca_alimentacao_copo" data-custom-field-type="texto" />
    </label>
    <label class="field-wrap span-4">
      <span class="input-label">Como e a alimentacao atual? Faz selecao? Tem preferencias?</span>
      <textarea class="input-control textarea-control" name="campoExtra_crianca_alimentacao_atual" rows="2" data-custom-field-key="crianca_alimentacao_atual" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_alimentacao_atual || '' %></textarea>
    </label>
    <label class="field-wrap span-4">
      <span class="input-label">Mastigacao (lenta/rapida/engole sem mastigar/engasga com facilidade)</span>
      <input class="input-control" type="text" name="campoExtra_crianca_alimentacao_mastigacao" value="<%= familia?.camposExtras?.crianca_alimentacao_mastigacao || '' %>" data-custom-field-key="crianca_alimentacao_mastigacao" data-custom-field-type="texto" />
    </label>
  </div>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title">
    <span class="form-subsection-icon" style="background:#fff4f7;color:#c2416d"><i class="fa-solid fa-person-walking" aria-hidden="true"></i></span>
    Desenvolvimento psicomotor e controle de esfincteres
  </h3>
  <div class="form-grid">
    <label class="field-wrap"><span class="input-label">Com que idade sustentou a cabeca?</span><input class="input-control" type="text" name="campoExtra_crianca_psico_cabeca" value="<%= familia?.camposExtras?.crianca_psico_cabeca || '' %>" data-custom-field-key="crianca_psico_cabeca" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Com que idade sentou?</span><input class="input-control" type="text" name="campoExtra_crianca_psico_sentou" value="<%= familia?.camposExtras?.crianca_psico_sentou || '' %>" data-custom-field-key="crianca_psico_sentou" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Com que idade engatinhou?</span><input class="input-control" type="text" name="campoExtra_crianca_psico_engatinhou" value="<%= familia?.camposExtras?.crianca_psico_engatinhou || '' %>" data-custom-field-key="crianca_psico_engatinhou" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Forma de engatinhar</span><input class="input-control" type="text" name="campoExtra_crianca_psico_forma_engatinhar" value="<%= familia?.camposExtras?.crianca_psico_forma_engatinhar || '' %>" data-custom-field-key="crianca_psico_forma_engatinhar" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Com que idade comecou a andar?</span><input class="input-control" type="text" name="campoExtra_crianca_psico_andar" value="<%= familia?.camposExtras?.crianca_psico_andar || '' %>" data-custom-field-key="crianca_psico_andar" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Caia muito? (sim/nao)</span><input class="input-control" type="text" name="campoExtra_crianca_psico_caia_muito" value="<%= familia?.camposExtras?.crianca_psico_caia_muito || '' %>" data-custom-field-key="crianca_psico_caia_muito" data-custom-field-type="texto" /></label>
    <label class="field-wrap span-2"><span class="input-label">Onde ficava quando bebe? E hoje?</span><textarea class="input-control textarea-control" name="campoExtra_crianca_psico_onde_ficava" rows="2" data-custom-field-key="crianca_psico_onde_ficava" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_psico_onde_ficava || '' %></textarea></label>
    <label class="field-wrap"><span class="input-label">Deixa as coisas cairem com facilidade? (sim/nao)</span><input class="input-control" type="text" name="campoExtra_crianca_psico_deixa_cair" value="<%= familia?.camposExtras?.crianca_psico_deixa_cair || '' %>" data-custom-field-key="crianca_psico_deixa_cair" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Esbarra muito em pessoas/coisas? (sim/nao)</span><input class="input-control" type="text" name="campoExtra_crianca_psico_esbarra" value="<%= familia?.camposExtras?.crianca_psico_esbarra || '' %>" data-custom-field-key="crianca_psico_esbarra" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Dominancia manual (direita/esquerda/ambas)</span><input class="input-control" type="text" name="campoExtra_crianca_psico_dominancia_manual" value="<%= familia?.camposExtras?.crianca_psico_dominancia_manual || '' %>" data-custom-field-key="crianca_psico_dominancia_manual" data-custom-field-type="texto" /></label>
    <label class="field-wrap span-3"><span class="input-label">Apresenta dificuldade motora? Qual?</span><textarea class="input-control textarea-control" name="campoExtra_crianca_psico_dificuldade_motora" rows="2" data-custom-field-key="crianca_psico_dificuldade_motora" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_psico_dificuldade_motora || '' %></textarea></label>
    <label class="field-wrap"><span class="input-label">Controle vesical (sim/nao) e idade</span><input class="input-control" type="text" name="campoExtra_crianca_esfincteres_vesical" value="<%= familia?.camposExtras?.crianca_esfincteres_vesical || '' %>" data-custom-field-key="crianca_esfincteres_vesical" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Controle anal (sim/nao) e idade</span><input class="input-control" type="text" name="campoExtra_crianca_esfincteres_anal" value="<%= familia?.camposExtras?.crianca_esfincteres_anal || '' %>" data-custom-field-key="crianca_esfincteres_anal" data-custom-field-type="texto" /></label>
    <label class="field-wrap span-2"><span class="input-label">Foi dificil ou tranquilo? Houve pressao da familia?</span><textarea class="input-control textarea-control" name="campoExtra_crianca_esfincteres_processo" rows="2" data-custom-field-key="crianca_esfincteres_processo" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_esfincteres_processo || '' %></textarea></label>
  </div>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title">
    <span class="form-subsection-icon" style="background:#eff6ff;color:#1d4ed8"><i class="fa-solid fa-comments" aria-hidden="true"></i></span>
    Desenvolvimento da linguagem
  </h3>
  <div class="form-grid">
    <label class="field-wrap"><span class="input-label">Idade dos primeiros balbucios</span><input class="input-control" type="text" name="campoExtra_crianca_linguagem_balbucios" value="<%= familia?.camposExtras?.crianca_linguagem_balbucios || '' %>" data-custom-field-key="crianca_linguagem_balbucios" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Primeira palavra</span><input class="input-control" type="text" name="campoExtra_crianca_linguagem_primeira_palavra" value="<%= familia?.camposExtras?.crianca_linguagem_primeira_palavra || '' %>" data-custom-field-key="crianca_linguagem_primeira_palavra" data-custom-field-type="texto" /></label>
