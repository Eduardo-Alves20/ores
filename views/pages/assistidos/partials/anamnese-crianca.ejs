    <label class="field-wrap"><span class="input-label">Foi estimulado(a) a falar? (sim/nao)</span><input class="input-control" type="text" name="campoExtra_crianca_linguagem_estimulo" value="<%= familia?.camposExtras?.crianca_linguagem_estimulo || '' %>" data-custom-field-key="crianca_linguagem_estimulo" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Quem conversa mais com a crianca?</span><input class="input-control" type="text" name="campoExtra_crianca_linguagem_quem_conversa" value="<%= familia?.camposExtras?.crianca_linguagem_quem_conversa || '' %>" data-custom-field-key="crianca_linguagem_quem_conversa" data-custom-field-type="texto" /></label>
    <label class="field-wrap span-2"><span class="input-label">Quando falava errado, qual a reacao dos pais?</span><textarea class="input-control textarea-control" name="campoExtra_crianca_linguagem_reacao_erro" rows="2" data-custom-field-key="crianca_linguagem_reacao_erro" data-custom-field-type="textarea"><%= familia?.camposExtras?.crianca_linguagem_reacao_erro || '' %></textarea></label>
