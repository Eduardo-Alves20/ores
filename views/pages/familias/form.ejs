          <label class="field-wrap span-4">
            <span class="input-label">Análise técnica / parecer social *</span>
            <textarea class="input-control textarea-control" name="campoExtra_parecer_social" rows="5" placeholder="Síntese da entrevista articulando contexto, vulnerabilidades, potencialidades e necessidades. Fundamento técnico para a decisão de inclusão e plano de acompanhamento." data-custom-field-key="parecer_social" data-custom-field-type="textarea"><%= familia?.camposExtras?.parecer_social || '' %></textarea>
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Encaminhamentos realizados</span>
            <textarea class="input-control textarea-control" name="campoExtra_encaminhamentos" rows="3" placeholder="Ex: CRAS para CadÚnico; UBS para puericultura; CAPS..." data-custom-field-key="encaminhamentos" data-custom-field-type="textarea"><%= familia?.camposExtras?.encaminhamentos || '' %></textarea>
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Plano de acompanhamento</span>
            <textarea class="input-control textarea-control" name="campoExtra_plano_acompanhamento" rows="3" placeholder="Frequência, responsáveis, próximos passos, prazo de reavaliação." data-custom-field-key="plano_acompanhamento" data-custom-field-type="textarea"><%= familia?.camposExtras?.plano_acompanhamento || '' %></textarea>
          </label>
          <label class="field-wrap">
            <span class="input-label">Decisão sobre inclusão</span>
            <select class="input-control" name="campoExtra_decisao_inclusao" data-custom-field-key="decisao_inclusao" data-custom-field-type="select">
              <% const diAtual = familia?.camposExtras?.decisao_inclusao || ''; %>
              <option value="">Selecionar...</option>
              <option value="incluido"     <%= diAtual==='incluido'?'selected':'' %>>Incluído</option>
              <option value="em_analise"   <%= diAtual==='em_analise'?'selected':'' %>>Em análise</option>
              <option value="aguardando"   <%= diAtual==='aguardando'?'selected':'' %>>Aguardando documentação</option>
              <option value="encaminhado"  <%= diAtual==='encaminhado'?'selected':'' %>>Encaminhado a outro serviço</option>
              <option value="nao_incluido" <%= diAtual==='nao_incluido'?'selected':'' %>>Não incluído</option>
            </select>
          </label>
          <div class="field-wrap">
            <span class="input-label">Prioridade</span>
            <div class="radio-group">
              <% const prioAtual = familia?.camposExtras?.prioridade || ''; %>
              <label class="radio-pill <%= prioAtual==='baixa'?'is-selected':'' %>"><input type="radio" name="campoExtra_prioridade" value="baixa" <%= prioAtual==='baixa'?'checked':'' %> data-custom-field-key="prioridade" data-custom-field-type="texto" />Baixa</label>
              <label class="radio-pill <%= prioAtual==='media'?'is-selected':'' %>"><input type="radio" name="campoExtra_prioridade" value="media" <%= prioAtual==='media'?'checked':'' %> data-custom-field-key="prioridade" data-custom-field-type="texto" />Média</label>
              <label class="radio-pill <%= prioAtual==='alta'?'is-selected':'' %>"><input type="radio" name="campoExtra_prioridade" value="alta" <%= prioAtual==='alta'?'checked':'' %> data-custom-field-key="prioridade" data-custom-field-type="texto" />Alta</label>
            </div>
          </div>
          <label class="field-wrap span-2">
            <span class="input-label">Próxima reavaliação</span>
            <input class="input-control" type="date" name="campoExtra_proxima_reavaliacao" value="<%= familia?.camposExtras?.proxima_reavaliacao || '' %>" data-custom-field-key="proxima_reavaliacao" data-custom-field-type="data" />
          </label>
        </div>
      </div>
    </div>

    <%# ════════════════════════════════════════════════ %>
    <%# ETAPA 5 — Anexos e documentos                   %>
    <%# ════════════════════════════════════════════════ %>
    <div class="wizard-panel" data-panel="5" hidden>
      <div class="wizard-panel-header">
        <div>
          <h2 class="wizard-panel-title">Anexos e documentos</h2>
          <p class="wizard-panel-subtitle">Comprovantes, fotos e relatórios anexados ao prontuário.</p>
        </div>
        <span class="wizard-panel-badge" id="badge-panel-5" hidden></span>
      </div>

      <div class="wizard-info-notice">
        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
        <span>Documentos podem ser anexados a qualquer momento. O cadastro pode ser concluído sem todos os anexos — documentos pendentes ficam anotados no prontuário.</span>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon"><i class="fa-solid fa-folder-open" aria-hidden="true"></i></span>
          Categorias sugeridas
        </h3>
        <div class="upload-cards-grid">
          <div class="upload-card">
            <div class="upload-card-head">
              <span class="upload-card-title">Documentação</span>
              <span class="upload-card-badge is-required">OBRIGATÓRIO</span>
            </div>
            <p class="upload-card-desc">RG, CPF, carteirinhas, NIS, CadÚnico</p>
            <label class="upload-card-drop">
              <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
              <span>Clique ou arraste o arquivo</span>
              <small>PDF, JPG, PNG até 10MB</small>
              <input type="file" name="anexo_documentacao" multiple accept=".pdf,.jpg,.jpeg,.png" />
            </label>
          </div>
          <div class="upload-card">
            <div class="upload-card-head">
              <span class="upload-card-title">Comprovante de residência</span>
              <span class="upload-card-badge is-required">OBRIGATÓRIO</span>
            </div>
            <p class="upload-card-desc">Conta de luz/água dos últimos 3 meses</p>
            <label class="upload-card-drop">
              <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
              <span>Clique ou arraste o arquivo</span>
              <small>PDF, JPG, PNG até 10MB</small>
              <input type="file" name="anexo_residencia" accept=".pdf,.jpg,.jpeg,.png" />
            </label>
          </div>
          <div class="upload-card">
            <div class="upload-card-head">
              <span class="upload-card-title">Comprovante de renda</span>
              <span class="upload-card-badge is-optional">Opcional</span>
            </div>
            <p class="upload-card-desc">Holerite, declaração, extrato de benefício</p>
            <label class="upload-card-drop">
              <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
              <span>Clique ou arraste o arquivo</span>
              <small>PDF, JPG, PNG até 10MB</small>
              <input type="file" name="anexo_renda" accept=".pdf,.jpg,.jpeg,.png" />
            </label>
          </div>
          <div class="upload-card">
            <div class="upload-card-head">
              <span class="upload-card-title">Documentos de saúde</span>
              <span class="upload-card-badge is-optional">Opcional</span>
            </div>
            <p class="upload-card-desc">Cartões de vacinação, receitas, relatórios</p>
            <label class="upload-card-drop">
              <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
              <span>Clique ou arraste o arquivo</span>
              <small>PDF, JPG, PNG até 10MB</small>
              <input type="file" name="anexo_saude" multiple accept=".pdf,.jpg,.jpeg,.png" />
            </label>
          </div>
          <div class="upload-card">
            <div class="upload-card-head">
              <span class="upload-card-title">Foto do assistido</span>
              <span class="upload-card-badge is-optional">Opcional</span>
            </div>
            <p class="upload-card-desc">Para identificação no prontuário</p>
            <label class="upload-card-drop">
              <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
              <span>Clique ou arraste o arquivo</span>
              <small>PDF, JPG, PNG até 10MB</small>
              <input type="file" name="anexo_foto" accept=".jpg,.jpeg,.png" />
            </label>
          </div>
          <div class="upload-card">
            <div class="upload-card-head">
              <span class="upload-card-title">Outros documentos</span>
              <span class="upload-card-badge is-optional">Opcional</span>
            </div>
            <p class="upload-card-desc">Qualquer documento relevante adicional</p>
            <label class="upload-card-drop">
              <i class="fa-solid fa-cloud-arrow-up" aria-hidden="true"></i>
              <span>Clique ou arraste o arquivo</span>
              <small>PDF, JPG, PNG até 10MB</small>
              <input type="file" name="anexo_outros" multiple accept=".pdf,.jpg,.jpeg,.png" />
            </label>
          </div>
        </div>
      </div>

      <div class="form-subsection" id="annexo-files-section" hidden>
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon"><i class="fa-solid fa-paperclip" aria-hidden="true"></i></span>
          <span id="annexo-files-title">Arquivos anexados (0)</span>
        </h3>
        <div class="annexo-files-list" id="annexo-files-list"></div>
      </div>

      <% if (modo === "editar") { %>
        <div class="form-subsection">
          <h3 class="form-subsection-title">
            <span class="form-subsection-icon"><i class="fa-solid fa-circle-dot" aria-hidden="true"></i></span>
            Status
          </h3>
          <label class="field-wrap">
            <span class="input-label">Assistido ativo</span>
            <select class="input-control" name="ativo" style="max-width:200px">
              <option value="true"  <%= familia?.ativo?'selected':'' %>>Sim</option>
              <option value="false" <%= !familia?.ativo?'selected':'' %>>Não</option>
            </select>
          </label>
        </div>
      <% } %>
    </div>

    <%# ════════════════════════════════════════════════ %>
    <%# ETAPA 6 — Resumo                                %>
    <%# ════════════════════════════════════════════════ %>
    <div class="wizard-panel" data-panel="6" hidden>
      <div class="wizard-panel-header">
        <div>
          <h2 class="wizard-panel-title">Revisão e salvamento</h2>
          <p class="wizard-panel-subtitle">Confira os dados antes de cadastrar o assistido.</p>
        </div>
      </div>
      <div id="resumo-content" class="resumo-wizard-grid"></div>
    </div>

    <%# Campos extras configurados por admins (hidden panel) %>
    <% if (Array.isArray(customFields) && customFields.length) { %>
      <% customFields.forEach((field) => { %>
        <% const fieldValue = familia?.camposExtras?.[field.chave]; %>
        <% if (field.tipo === 'textarea') { %>
          <textarea class="input-control textarea-control" name="campoExtra_<%= field.chave %>" rows="4" placeholder="<%= field.placeholder||'' %>" data-custom-field-key="<%= field.chave %>" data-custom-field-type="<%= field.tipo %>" hidden><%= fieldValue||'' %></textarea>
        <% } else if (field.tipo !== 'booleano' && field.tipo !== 'select') { %>
          <input class="input-control" type="<%= field.tipo==='numero'?'number':field.tipo==='data'?'date':'text' %>" name="campoExtra_<%= field.chave %>" value="<%= fieldValue||'' %>" data-custom-field-key="<%= field.chave %>" data-custom-field-type="<%= field.tipo %>" hidden />
        <% } %>
      <% }) %>
    <% } %>

    <div id="familia-form-feedback" class="form-feedback" hidden></div>

    <div class="wizard-nav">
      <div class="wizard-nav-left">
        <button type="button" class="btn btn-muted" id="wizard-prev" hidden>
          <i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Voltar
        </button>
      </div>
      <span class="wizard-nav-center" id="wizard-step-label">Etapa 1 de 6</span>
      <div class="wizard-nav-right">
        <button type="button" class="btn btn-ghost" id="wizard-save-draft">Salvar e continuar depois</button>
        <button type="button" class="btn btn-primary" id="wizard-next">
          Avançar <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
        </button>
        <button type="submit" class="btn btn-primary" id="wizard-submit" hidden>
          <i class="fa-solid fa-floppy-disk" aria-hidden="true"></i>
          <%= modo === "editar" ? "Salvar Alterações" : "Cadastrar Assistido" %>
        </button>
      </div>
    </div>
  </form>
</section>

<script <%- typeof renderCspNonceAttr === "function" ? renderCspNonceAttr() : "" %> id="familia-form-initial" type="application/json"><%- serializeForInlineScript(familia || null) %></script>
