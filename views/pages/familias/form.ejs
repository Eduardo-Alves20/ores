              <option value="">Selecionar...</option>
              <option value="trabalho_formal" <%= orAtual==='trabalho_formal'?'selected':'' %>>Trabalho formal</option>
              <option value="trabalho_informal" <%= orAtual==='trabalho_informal'?'selected':'' %>>Trabalho informal</option>
              <option value="aposentadoria"  <%= orAtual==='aposentadoria'?'selected':'' %>>Aposentadoria / Pensão</option>
              <option value="beneficio_social" <%= orAtual==='beneficio_social'?'selected':'' %>>Benefício social</option>
              <option value="nenhuma"        <%= orAtual==='nenhuma'?'selected':'' %>>Nenhuma</option>
            </select>
          </label>
        </div>
      </div>

      <%# Habitação e território %>
      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon"><i class="fa-solid fa-house-flag" aria-hidden="true"></i></span>
