              <% const htmAtual = familia?.camposExtras?.hab_tipo_moradia || ''; %>
              <option value="">Selecionar...</option>
              <option value="propria"     <%= htmAtual==='propria'?'selected':'' %>>Própria</option>
              <option value="alugada"     <%= htmAtual==='alugada'?'selected':'' %>>Alugada</option>
              <option value="cedida"      <%= htmAtual==='cedida'?'selected':'' %>>Cedida</option>
              <option value="ocupacao"    <%= htmAtual==='ocupacao'?'selected':'' %>>Ocupação</option>
