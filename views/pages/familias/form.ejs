          <label class="field-wrap">
            <span class="input-label">Local</span>
            <select class="input-control" name="campoExtra_local_entrevista" data-custom-field-key="local_entrevista" data-custom-field-type="select">
              <% const leAtual = familia?.camposExtras?.local_entrevista || ''; %>
              <option value="">Selecionar...</option>
              <option value="sede"       <%= leAtual==='sede'?'selected':'' %>>Sede da instituição</option>
              <option value="domicilio"  <%= leAtual==='domicilio'?'selected':'' %>>Domicílio</option>
              <option value="cras"       <%= leAtual==='cras'?'selected':'' %>>CRAS / CREAS</option>
              <option value="ubs"        <%= leAtual==='ubs'?'selected':'' %>>UBS</option>
              <option value="remoto"     <%= leAtual==='remoto'?'selected':'' %>>Remoto (vídeo/telefone)</option>
              <option value="outro"      <%= leAtual==='outro'?'selected':'' %>>Outro</option>
            </select>
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Modalidade</span>
            <select class="input-control" name="campoExtra_modalidade_entrevista" data-custom-field-key="modalidade_entrevista" data-custom-field-type="select">
              <% const meAtual = familia?.camposExtras?.modalidade_entrevista || ''; %>
              <option value="">Selecionar...</option>
              <option value="individual"  <%= meAtual==='individual'?'selected':'' %>>Individual</option>
              <option value="familiar"    <%= meAtual==='familiar'?'selected':'' %>>Familiar</option>
              <option value="domiciliar"  <%= meAtual==='domiciliar'?'selected':'' %>>Domiciliar</option>
              <option value="grupo"       <%= meAtual==='grupo'?'selected':'' %>>Grupo</option>
            </select>
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Profissional responsável *</span>
            <input class="input-control" type="text" name="campoExtra_profissional_entrevista" value="<%= familia?.camposExtras?.profissional_entrevista || '' %>" placeholder="Nome do profissional" data-custom-field-key="profissional_entrevista" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Pessoa(s) presente(s)</span>
            <input class="input-control" type="text" name="campoExtra_presentes_entrevista" value="<%= familia?.camposExtras?.presentes_entrevista || '' %>" placeholder="Quem participou da entrevista?" data-custom-field-key="presentes_entrevista" data-custom-field-type="texto" />
          </label>
        </div>
      </div>

      <%# Composição familiar %>
