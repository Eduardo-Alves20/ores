              <label class="radio-pill <%= casCrasAtual==='nao_sabe'?'is-selected':'' %>"><input type="radio" name="campoExtra_cadastrado_cras" value="nao_sabe" <%= casCrasAtual==='nao_sabe'?'checked':'' %> data-custom-field-key="cadastrado_cras" data-custom-field-type="texto" />Não sabe</label>
