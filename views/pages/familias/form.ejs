              <label class="radio-pill <%= econsAtual==='regular'?'is-selected':'' %>"><input type="radio" name="campoExtra_hab_estado_conservacao" value="regular" <%= econsAtual==='regular'?'checked':'' %> data-custom-field-key="hab_estado_conservacao" data-custom-field-type="texto" />Regular</label>
              <label class="radio-pill <%= econsAtual==='precario'?'is-selected':'' %>"><input type="radio" name="campoExtra_hab_estado_conservacao" value="precario" <%= econsAtual==='precario'?'checked':'' %> data-custom-field-key="hab_estado_conservacao" data-custom-field-type="texto" />Precário</label>
            </div>
          </div>
          <label class="field-wrap">
            <span class="input-label">Nº de cômodos</span>
            <input class="input-control" type="number" name="campoExtra_hab_comodos" value="<%= familia?.camposExtras?.hab_comodos || '' %>" min="1" placeholder="Ex: 4" data-custom-field-key="hab_comodos" data-custom-field-type="numero" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Nº de dormitórios</span>
            <input class="input-control" type="number" name="campoExtra_hab_dormitorios" value="<%= familia?.camposExtras?.hab_dormitorios || '' %>" min="0" placeholder="Ex: 2" data-custom-field-key="hab_dormitorios" data-custom-field-type="numero" />
