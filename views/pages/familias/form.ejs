<section
  class="page-shell familias-layout"
  data-page="familias-form"
  data-mode="<%= modo %>"
  data-familia-id="<%= familia?._id || '' %>"
>
  <nav class="familias-breadcrumb" aria-label="Trilha de navegacao">
    <a class="familias-breadcrumb-link" href="/painel">Painel</a>
    <span class="familias-breadcrumb-sep" aria-hidden="true">/</span>
    <a class="familias-breadcrumb-link" href="/familias">Assistidos</a>
    <span class="familias-breadcrumb-sep" aria-hidden="true">/</span>
    <% if (modo === "editar" && familia?._id) { %>
      <a class="familias-breadcrumb-link" href="/familias/<%= familia._id %>"><%= familia?.responsavel?.nome || "Assistido" %></a>
      <span class="familias-breadcrumb-sep" aria-hidden="true">/</span>
    <% } %>
    <span class="familias-breadcrumb-current"><%= modo === "editar" ? "Editar assistido" : "Novo assistido" %></span>
  </nav>

  <%# ── Wizard step indicator ── %>
  <div class="cadastro-wizard-steps card-elevated">
    <div class="wizard-steps-header">
      <span class="wizard-steps-label">ETAPAS DO CADASTRO</span>
      <div class="wizard-progress-info">
        <span class="wizard-progress-text" id="wizard-progress-text">0 de 6 preenchidas &mdash; 0%</span>
        <div class="wizard-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
          <div class="wizard-progress-fill" id="wizard-progress-fill" style="width:0%"></div>
        </div>
      </div>
    </div>
    <div class="wizard-steps-list">
      <div class="wizard-step-item is-active" data-step="1" role="button" tabindex="0">
        <div class="wizard-step-circle">1</div>
        <div class="wizard-step-info">
          <span class="wizard-step-name">Dados pessoais</span>
          <span class="wizard-step-subtitle">Identificação e contato</span>
        </div>
      </div>
      <div class="wizard-step-connector" id="connector-1"></div>
      <div class="wizard-step-item" data-step="2" role="button" tabindex="0">
        <div class="wizard-step-circle">2</div>
        <div class="wizard-step-info">
          <span class="wizard-step-name">Endereço</span>
          <span class="wizard-step-subtitle">Residência e território</span>
        </div>
      </div>
      <div class="wizard-step-connector" id="connector-2"></div>
      <div class="wizard-step-item" data-step="3" role="button" tabindex="0">
        <div class="wizard-step-circle">3</div>
        <div class="wizard-step-info">
          <span class="wizard-step-name">Anamnese</span>
          <span class="wizard-step-subtitle">Ficha clínica adaptada</span>
        </div>
      </div>
      <div class="wizard-step-connector" id="connector-3"></div>
      <div class="wizard-step-item" data-step="4" role="button" tabindex="0">
        <div class="wizard-step-circle">4</div>
        <div class="wizard-step-info">
          <span class="wizard-step-name">Entrevista social</span>
          <span class="wizard-step-subtitle">Diagnóstico social</span>
        </div>
      </div>
      <div class="wizard-step-connector" id="connector-4"></div>
      <div class="wizard-step-item" data-step="5" role="button" tabindex="0">
        <div class="wizard-step-circle">5</div>
        <div class="wizard-step-info">
          <span class="wizard-step-name">Anexos</span>
          <span class="wizard-step-subtitle">Documentos comprobatórios</span>
        </div>
      </div>
      <div class="wizard-step-connector" id="connector-5"></div>
      <div class="wizard-step-item" data-step="6" role="button" tabindex="0">
        <div class="wizard-step-circle">6</div>
        <div class="wizard-step-info">
          <span class="wizard-step-name">Resumo</span>
          <span class="wizard-step-subtitle">Revisão e salvamento</span>
        </div>
      </div>
    </div>
  </div>

  <form id="familia-form" class="familia-form card-elevated" novalidate>

    <%# ════════════════════════════════════════════════ %>
    <%# ETAPA 1 — Dados pessoais                        %>
    <%# ════════════════════════════════════════════════ %>
    <div class="wizard-panel" data-panel="1">
      <div class="wizard-panel-header">
        <div>
          <h2 class="wizard-panel-title">Dados pessoais do assistido</h2>
          <p class="wizard-panel-subtitle">Identificação completa, contato e vínculo familiar.</p>
        </div>
        <span class="wizard-panel-badge" id="badge-panel-1" hidden></span>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon"><i class="fa-solid fa-id-card" aria-hidden="true"></i></span>
          Identificação
        </h3>
        <div class="form-grid">
          <label class="field-wrap span-2">
            <span class="input-label">Nome completo *</span>
            <input class="input-control" type="text" name="responsavel_nome" value="<%= familia?.responsavel?.nome || '' %>" placeholder="Nome completo do assistido" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Nome social</span>
            <input class="input-control" type="text" name="campoExtra_nome_social" value="<%= familia?.camposExtras?.nome_social || '' %>" placeholder="Como prefere ser chamado(a)" data-custom-field-key="nome_social" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap">
            <span class="input-label">CPF *</span>
            <input class="input-control" type="text" name="campoExtra_cpf" value="<%= familia?.camposExtras?.cpf || '' %>" placeholder="123.456.789-00" data-custom-field-key="cpf" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap">
            <span class="input-label">RG</span>
            <input class="input-control" type="text" name="campoExtra_rg" value="<%= familia?.camposExtras?.rg || '' %>" placeholder="00.000.000-0" data-custom-field-key="rg" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Órgão emissor / UF</span>
            <input class="input-control" type="text" name="campoExtra_orgao_emissor" value="<%= familia?.camposExtras?.orgao_emissor || '' %>" placeholder="SSP/SP" data-custom-field-key="orgao_emissor" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Data de nascimento *</span>
            <input class="input-control" type="date" name="campoExtra_data_nascimento" value="<%= familia?.camposExtras?.data_nascimento || '' %>" data-custom-field-key="data_nascimento" data-custom-field-type="data" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Idade (calculada)</span>
            <input class="input-control" type="text" name="_idade_calculada" placeholder="—" readonly tabindex="-1" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Faixa para anamnese</span>
            <input class="input-control" type="text" name="_faixa_anamnese" placeholder="—" readonly tabindex="-1" />
          </label>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon"><i class="fa-solid fa-person" aria-hidden="true"></i></span>
          Características pessoais
        </h3>
        <div class="form-grid">
          <label class="field-wrap">
            <span class="input-label">Sexo biológico</span>
            <select class="input-control" name="campoExtra_sexo_biologico" data-custom-field-key="sexo_biologico" data-custom-field-type="select">
              <% const sexoBioAtual = familia?.camposExtras?.sexo_biologico || ''; %>
              <option value="">Selecionar...</option>
              <option value="masculino" <%= sexoBioAtual==='masculino'?'selected':'' %>>Masculino</option>
              <option value="feminino"  <%= sexoBioAtual==='feminino'?'selected':'' %>>Feminino</option>
              <option value="intersexo" <%= sexoBioAtual==='intersexo'?'selected':'' %>>Intersexo</option>
              <option value="nao_informado" <%= sexoBioAtual==='nao_informado'?'selected':'' %>>Prefiro não informar</option>
            </select>
          </label>
          <label class="field-wrap">
            <span class="input-label">Identidade de gênero</span>
            <select class="input-control" name="campoExtra_identidade_genero" data-custom-field-key="identidade_genero" data-custom-field-type="select">
              <% const idGenAtual = familia?.camposExtras?.identidade_genero || ''; %>
              <option value="">Selecionar...</option>
              <option value="homem_cis"    <%= idGenAtual==='homem_cis'?'selected':'' %>>Homem cisgênero</option>
              <option value="mulher_cis"   <%= idGenAtual==='mulher_cis'?'selected':'' %>>Mulher cisgênero</option>
              <option value="homem_trans"  <%= idGenAtual==='homem_trans'?'selected':'' %>>Homem transgênero</option>
              <option value="mulher_trans" <%= idGenAtual==='mulher_trans'?'selected':'' %>>Mulher transgênero</option>
              <option value="nao_binario"  <%= idGenAtual==='nao_binario'?'selected':'' %>>Não-binário</option>
              <option value="nao_informado" <%= idGenAtual==='nao_informado'?'selected':'' %>>Prefiro não informar</option>
            </select>
          </label>
          <label class="field-wrap">
            <span class="input-label">Estado civil</span>
            <select class="input-control" name="campoExtra_estado_civil" data-custom-field-key="estado_civil" data-custom-field-type="select">
              <% const ecAtual = familia?.camposExtras?.estado_civil || ''; %>
              <option value="">Selecionar...</option>
              <option value="solteiro"      <%= ecAtual==='solteiro'?'selected':'' %>>Solteiro(a)</option>
              <option value="casado"        <%= ecAtual==='casado'?'selected':'' %>>Casado(a)</option>
              <option value="uniao_estavel" <%= ecAtual==='uniao_estavel'?'selected':'' %>>União estável</option>
              <option value="divorciado"    <%= ecAtual==='divorciado'?'selected':'' %>>Divorciado(a)</option>
              <option value="viuvo"         <%= ecAtual==='viuvo'?'selected':'' %>>Viúvo(a)</option>
              <option value="separado"      <%= ecAtual==='separado'?'selected':'' %>>Separado(a)</option>
            </select>
          </label>
          <label class="field-wrap">
            <span class="input-label">Cor / raça (autodeclaração)</span>
            <select class="input-control" name="campoExtra_cor_raca" data-custom-field-key="cor_raca" data-custom-field-type="select">
              <% const crAtual = familia?.camposExtras?.cor_raca || ''; %>
              <option value="">Selecionar...</option>
              <option value="branca"     <%= crAtual==='branca'?'selected':'' %>>Branca</option>
              <option value="preta"      <%= crAtual==='preta'?'selected':'' %>>Preta</option>
              <option value="parda"      <%= crAtual==='parda'?'selected':'' %>>Parda</option>
              <option value="amarela"    <%= crAtual==='amarela'?'selected':'' %>>Amarela</option>
              <option value="indigena"   <%= crAtual==='indigena'?'selected':'' %>>Indígena</option>
              <option value="nao_declarado" <%= crAtual==='nao_declarado'?'selected':'' %>>Não declarado</option>
            </select>
          </label>
          <label class="field-wrap">
            <span class="input-label">Naturalidade</span>
            <input class="input-control" type="text" name="campoExtra_naturalidade" value="<%= familia?.camposExtras?.naturalidade || '' %>" placeholder="Cidade / UF de nascimento" data-custom-field-key="naturalidade" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Nacionalidade</span>
            <input class="input-control" type="text" name="campoExtra_nacionalidade" value="<%= familia?.camposExtras?.nacionalidade || 'Brasileira' %>" data-custom-field-key="nacionalidade" data-custom-field-type="texto" />
          </label>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon"><i class="fa-solid fa-phone" aria-hidden="true"></i></span>
          Contato
        </h3>
        <div class="form-grid">
          <label class="field-wrap">
            <span class="input-label">Telefone principal *</span>
            <input class="input-control" type="text" name="responsavel_telefone" value="<%= familia?.responsavel?.telefone || '' %>" placeholder="(11) 99999-9999" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Telefone secundário</span>
            <input class="input-control" type="text" name="campoExtra_telefone_secundario" value="<%= familia?.camposExtras?.telefone_secundario || '' %>" placeholder="(11) 99999-9999" data-custom-field-key="telefone_secundario" data-custom-field-type="texto" />
          </label>
          <div class="field-wrap">
            <span class="input-label">É WhatsApp?</span>
            <div class="radio-group">
              <% const isWaAtual = familia?.camposExtras?.is_whatsapp || 'sim'; %>
              <label class="radio-pill <%= isWaAtual==='sim'?'is-selected':'' %>"><input type="radio" name="campoExtra_is_whatsapp" value="sim" <%= isWaAtual==='sim'?'checked':'' %> data-custom-field-key="is_whatsapp" data-custom-field-type="texto" />Sim</label>
              <label class="radio-pill <%= isWaAtual==='nao'?'is-selected':'' %>"><input type="radio" name="campoExtra_is_whatsapp" value="nao" <%= isWaAtual==='nao'?'checked':'' %> data-custom-field-key="is_whatsapp" data-custom-field-type="texto" />Não</label>
            </div>
          </div>
          <label class="field-wrap">
            <span class="input-label">Email</span>
            <input class="input-control" type="email" name="responsavel_email" value="<%= familia?.responsavel?.email || '' %>" placeholder="email@exemplo.com" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Permissão de contato</span>
            <select class="input-control" name="campoExtra_permissao_contato" data-custom-field-key="permissao_contato" data-custom-field-type="select">
              <% const permAtual = familia?.camposExtras?.permissao_contato || 'qualquer'; %>
              <option value="qualquer"       <%= permAtual==='qualquer'?'selected':'' %>>Qualquer canal</option>
              <option value="apenas_telefone" <%= permAtual==='apenas_telefone'?'selected':'' %>>Apenas telefone</option>
              <option value="apenas_whatsapp" <%= permAtual==='apenas_whatsapp'?'selected':'' %>>Apenas WhatsApp</option>
              <option value="apenas_email"   <%= permAtual==='apenas_email'?'selected':'' %>>Apenas email</option>
              <option value="nao_contatar"   <%= permAtual==='nao_contatar'?'selected':'' %>>Não contatar</option>
            </select>
          </label>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon"><i class="fa-solid fa-people-roof" aria-hidden="true"></i></span>
          Vínculo familiar
        </h3>
        <div class="form-grid">
          <label class="field-wrap span-2">
            <span class="input-label">Família vinculada</span>
            <input class="input-control" type="text" name="campoExtra_familia_vinculada" value="<%= familia?.camposExtras?.familia_vinculada || '' %>" placeholder="Buscar família existente..." data-custom-field-key="familia_vinculada" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Parentesco / vínculo *</span>
            <select class="input-control" name="responsavel_parentesco">
              <% const parAtual = familia?.responsavel?.parentesco || "responsavel"; %>
              <% [["responsavel","Responsável familiar"],["mae","Mãe"],["pai","Pai"],["tio","Tio(a)"],["avo","Avô / Avó"],["irmao","Irmão / Irmã"],["primo","Primo(a)"],["adotante","Adotante"],["outro","Outro"]].forEach(function(item){ %>
                <option value="<%= item[0] %>" <%= parAtual===item[0]?'selected':'' %>><%= item[1] %></option>
              <% }) %>
            </select>
          </label>
          <div class="field-wrap">
            <span class="input-label">É o(a) responsável principal?</span>
            <div class="radio-group">
              <% const ehRespAtual = familia?.camposExtras?.eh_responsavel || 'sim'; %>
              <label class="radio-pill <%= ehRespAtual==='sim'?'is-selected':'' %>"><input type="radio" name="campoExtra_eh_responsavel" value="sim" <%= ehRespAtual==='sim'?'checked':'' %> data-custom-field-key="eh_responsavel" data-custom-field-type="texto" />Sim</label>
              <label class="radio-pill <%= ehRespAtual==='nao'?'is-selected':'' %>"><input type="radio" name="campoExtra_eh_responsavel" value="nao" <%= ehRespAtual==='nao'?'checked':'' %> data-custom-field-key="eh_responsavel" data-custom-field-type="texto" />Não</label>
              <label class="radio-pill <%= ehRespAtual==='nao_sabe'?'is-selected':'' %>"><input type="radio" name="campoExtra_eh_responsavel" value="nao_sabe" <%= ehRespAtual==='nao_sabe'?'checked':'' %> data-custom-field-key="eh_responsavel" data-custom-field-type="texto" />Não sabe</label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# ════════════════════════════════════════════════ %>
    <%# ETAPA 2 — Endereço e moradia                    %>
    <%# ════════════════════════════════════════════════ %>
    <div class="wizard-panel" data-panel="2" hidden>
      <div class="wizard-panel-header">
        <div>
          <h2 class="wizard-panel-title">Endereço e moradia</h2>
          <p class="wizard-panel-subtitle">Onde o assistido reside e contato de emergência.</p>
        </div>
        <span class="wizard-panel-badge" id="badge-panel-2" hidden></span>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
          Endereço residencial
        </h3>
        <div class="form-grid">
          <label class="field-wrap">
            <span class="input-label">CEP *</span>
            <input class="input-control" type="text" name="endereco_cep" value="<%= familia?.endereco?.cep || '' %>" placeholder="00000-000" />
          </label>
          <label class="field-wrap span-3">
            <span class="input-label">Logradouro *</span>
            <input class="input-control" type="text" name="endereco_rua" value="<%= familia?.endereco?.rua || '' %>" placeholder="Rua, avenida, travessa..." />
          </label>
          <label class="field-wrap">
            <span class="input-label">Número *</span>
            <input class="input-control" type="text" name="endereco_numero" value="<%= familia?.endereco?.numero || '' %>" placeholder="Ex: 142" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Complemento</span>
            <input class="input-control" type="text" name="endereco_complemento" value="<%= familia?.endereco?.complemento || '' %>" placeholder="Apto, bloco, casa..." />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Ponto de referência</span>
            <input class="input-control" type="text" name="campoExtra_ponto_referencia" value="<%= familia?.camposExtras?.ponto_referencia || '' %>" placeholder="Próximo a..." data-custom-field-key="ponto_referencia" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Bairro *</span>
            <input class="input-control" type="text" name="endereco_bairro" value="<%= familia?.endereco?.bairro || '' %>" placeholder="Bairro" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Cidade *</span>
            <input class="input-control" type="text" name="endereco_cidade" value="<%= familia?.endereco?.cidade || '' %>" placeholder="São Paulo" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Estado *</span>
            <select class="input-control" name="endereco_estado">
              <% const ufAtual = familia?.endereco?.estado || ''; %>
              <option value="">UF</option>
              <% ["AC","AL","AP","AM","BA","CE","DF","ES","GO","MA","MT","MS","MG","PA","PB","PR","PE","PI","RJ","RN","RS","RO","RR","SC","SP","SE","TO"].forEach(function(uf){ %>
                <option value="<%= uf %>" <%= ufAtual===uf?'selected':'' %>><%= uf %></option>
              <% }) %>
            </select>
          </label>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon"><i class="fa-solid fa-house" aria-hidden="true"></i></span>
          Sobre a moradia
        </h3>
        <div class="form-grid">
          <label class="field-wrap">
            <span class="input-label">Tipo de moradia</span>
            <select class="input-control" name="campoExtra_tipo_moradia" data-custom-field-key="tipo_moradia" data-custom-field-type="select">
              <% const tmAtual = familia?.camposExtras?.tipo_moradia || ''; %>
              <option value="">Selecionar...</option>
              <option value="propria"     <%= tmAtual==='propria'?'selected':'' %>>Própria</option>
              <option value="alugada"     <%= tmAtual==='alugada'?'selected':'' %>>Alugada</option>
              <option value="cedida"      <%= tmAtual==='cedida'?'selected':'' %>>Cedida</option>
              <option value="ocupacao"    <%= tmAtual==='ocupacao'?'selected':'' %>>Ocupação</option>
              <option value="abrigo"      <%= tmAtual==='abrigo'?'selected':'' %>>Abrigo / Alojamento</option>
              <option value="sem_moradia" <%= tmAtual==='sem_moradia'?'selected':'' %>>Sem moradia fixa</option>
            </select>
          </label>
          <label class="field-wrap">
            <span class="input-label">Tempo de moradia</span>
            <input class="input-control" type="text" name="campoExtra_tempo_moradia" value="<%= familia?.camposExtras?.tempo_moradia || '' %>" placeholder="Ex: 3 anos" data-custom-field-key="tempo_moradia" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Microárea / Setor (se aplicável)</span>
            <input class="input-control" type="text" name="campoExtra_microarea" value="<%= familia?.camposExtras?.microarea || '' %>" placeholder="Ex: Microárea 7" data-custom-field-key="microarea" data-custom-field-type="texto" />
          </label>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon"><i class="fa-solid fa-phone" aria-hidden="true"></i></span>
          Contato em caso de emergência
        </h3>
        <div class="form-grid">
          <label class="field-wrap span-2">
            <span class="input-label">Nome</span>
            <input class="input-control" type="text" name="campoExtra_emergencia_nome" value="<%= familia?.camposExtras?.emergencia_nome || '' %>" placeholder="Nome completo" data-custom-field-key="emergencia_nome" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Telefone</span>
            <input class="input-control" type="text" name="campoExtra_emergencia_telefone" value="<%= familia?.camposExtras?.emergencia_telefone || '' %>" placeholder="(11) 99999-9999" data-custom-field-key="emergencia_telefone" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Vínculo / parentesco</span>
            <input class="input-control" type="text" name="campoExtra_emergencia_vinculo" value="<%= familia?.camposExtras?.emergencia_vinculo || '' %>" placeholder="Ex: Vizinha, Irmão..." data-custom-field-key="emergencia_vinculo" data-custom-field-type="texto" />
          </label>
          <div class="field-wrap span-2">
            <span class="input-label">Mora na mesma residência?</span>
            <div class="radio-group">
              <% const emgResAtual = familia?.camposExtras?.emergencia_mesma_residencia || ''; %>
              <label class="radio-pill <%= emgResAtual==='sim'?'is-selected':'' %>"><input type="radio" name="campoExtra_emergencia_mesma_residencia" value="sim" <%= emgResAtual==='sim'?'checked':'' %> data-custom-field-key="emergencia_mesma_residencia" data-custom-field-type="texto" />Sim</label>
              <label class="radio-pill <%= emgResAtual==='nao'?'is-selected':'' %>"><input type="radio" name="campoExtra_emergencia_mesma_residencia" value="nao" <%= emgResAtual==='nao'?'checked':'' %> data-custom-field-key="emergencia_mesma_residencia" data-custom-field-type="texto" />Não</label>
              <label class="radio-pill <%= emgResAtual==='nao_sabe'?'is-selected':'' %>"><input type="radio" name="campoExtra_emergencia_mesma_residencia" value="nao_sabe" <%= emgResAtual==='nao_sabe'?'checked':'' %> data-custom-field-key="emergencia_mesma_residencia" data-custom-field-type="texto" />Não sabe</label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <%# ════════════════════════════════════════════════ %>
    <%# ETAPA 3 — Anamnese                              %>
    <%# ════════════════════════════════════════════════ %>
    <div class="wizard-panel" data-panel="3" hidden>
      <div class="wizard-panel-header">
        <div>
          <h2 class="wizard-panel-title" id="anamnese-panel-title">Anamnese</h2>
          <p class="wizard-panel-subtitle">Ficha clínica adaptada à faixa etária do assistido.</p>
        </div>
        <span class="wizard-panel-badge" id="badge-panel-3" hidden></span>
      </div>

      <%# Faixa seletor %>
      <div class="anamnese-faixa-bar">
        <div class="anamnese-faixa-info">
          <i class="fa-solid fa-file-medical anamnese-faixa-info-icon" aria-hidden="true"></i>
          <div class="anamnese-faixa-info-text">
            <strong id="anamnese-faixa-label">Ficha aplicada: Adulto (18-59 anos)</strong>
            <p id="anamnese-faixa-desc">Sugerida automaticamente pela idade do assistido. Doenças crônicas, hábitos de vida, saúde mental, trabalho e ocupação.</p>
          </div>
        </div>
        <div class="radio-group">
          <label class="radio-pill" id="faixa-btn-crianca"><input type="radio" name="_faixa_sel" value="crianca" />Criança</label>
          <label class="radio-pill is-selected" id="faixa-btn-adulto"><input type="radio" name="_faixa_sel" value="adulto" checked />Adulto</label>
          <label class="radio-pill" id="faixa-btn-idoso"><input type="radio" name="_faixa_sel" value="idoso" />Idoso</label>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon" style="background:#fef3f2;color:#e64b3b"><i class="fa-solid fa-heart-pulse" aria-hidden="true"></i></span>
          Saúde geral
        </h3>
        <div class="form-grid">
          <label class="field-wrap span-4">
            <span class="input-label">Queixa principal / motivo da procura *</span>
            <textarea class="input-control textarea-control" name="campoExtra_queixa_principal" rows="3" placeholder="Descreva com as palavras do próprio assistido sempre que possível." data-custom-field-key="queixa_principal" data-custom-field-type="textarea"><%= familia?.camposExtras?.queixa_principal || '' %></textarea>
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Estado geral percebido</span>
            <select class="input-control" name="campoExtra_estado_geral" data-custom-field-key="estado_geral" data-custom-field-type="select">
              <% const egAtual = familia?.camposExtras?.estado_geral || ''; %>
              <option value="">Selecionar...</option>
              <option value="otimo"    <%= egAtual==='otimo'?'selected':'' %>>Ótimo</option>
              <option value="bom"      <%= egAtual==='bom'?'selected':'' %>>Bom</option>
              <option value="regular"  <%= egAtual==='regular'?'selected':'' %>>Regular</option>
              <option value="ruim"     <%= egAtual==='ruim'?'selected':'' %>>Ruim</option>
              <option value="critico"  <%= egAtual==='critico'?'selected':'' %>>Crítico</option>
            </select>
          </label>
          <label class="field-wrap">
            <span class="input-label">Peso (kg)</span>
            <input class="input-control" type="text" name="campoExtra_peso" value="<%= familia?.camposExtras?.peso || '' %>" placeholder="Ex: 72" data-custom-field-key="peso" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Altura (cm)</span>
            <input class="input-control" type="text" name="campoExtra_altura" value="<%= familia?.camposExtras?.altura || '' %>" placeholder="Ex: 168" data-custom-field-key="altura" data-custom-field-type="texto" />
          </label>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon" style="background:#fef3f2;color:#e64b3b"><i class="fa-solid fa-stethoscope" aria-hidden="true"></i></span>
          Antecedentes pessoais
        </h3>
        <div class="form-grid">
          <div class="field-wrap span-4">
            <span class="input-label">Doenças crônicas / condições atuais</span>
            <div class="checkbox-grid" id="doencas-cronicas-grid">
              <% [["hipertensao","Hipertensão"],["diabetes","Diabetes"],["cardiopatia","Cardiopatia"],["asma_dpoc","Asma / DPOC"],["tireoide","Tireoide"],["obesidade","Obesidade"],["cancer","Câncer"],["hiv","HIV"],["hepatite","Hepatite"],["renais","Renais"],["reumaticas","Reumáticas"],["nenhuma_dc","Nenhuma"]].forEach(function(item){ %>
                <% const dcChecked = (familia?.camposExtras?.doencas_cronicas || '').includes(item[0]); %>
                <label class="checkbox-option <%= dcChecked?'is-checked':'' %>">
                  <input type="checkbox" class="checkbox-input" data-checkbox-group="doencas_cronicas" value="<%= item[0] %>" <%= dcChecked?'checked':'' %> />
                  <span class="checkbox-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                  <span><%= item[1] %></span>
                </label>
              <% }) %>
            </div>
          </div>
          <label class="field-wrap span-2">
            <span class="input-label">Cirurgias prévias</span>
            <textarea class="input-control textarea-control" name="campoExtra_cirurgias" rows="3" placeholder="Procedimento e ano..." data-custom-field-key="cirurgias" data-custom-field-type="textarea"><%= familia?.camposExtras?.cirurgias || '' %></textarea>
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Internações</span>
            <textarea class="input-control textarea-control" name="campoExtra_internacoes" rows="3" placeholder="Motivo e ano..." data-custom-field-key="internacoes" data-custom-field-type="textarea"><%= familia?.camposExtras?.internacoes || '' %></textarea>
          </label>
          <label class="field-wrap span-4">
            <span class="input-label">Medicamentos em uso contínuo</span>
            <textarea class="input-control textarea-control" name="campoExtra_medicamentos" rows="3" placeholder="Nome, dosagem, frequência. Ex: Losartana 50mg 1x ao dia." data-custom-field-key="medicamentos" data-custom-field-type="textarea"><%= familia?.camposExtras?.medicamentos || '' %></textarea>
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Alergias</span>
            <input class="input-control" type="text" name="campoExtra_alergias" value="<%= familia?.camposExtras?.alergias || '' %>" placeholder="Medicamentos, alimentos, outros..." data-custom-field-key="alergias" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Última consulta médica</span>
            <input class="input-control" type="text" name="campoExtra_ultima_consulta" value="<%= familia?.camposExtras?.ultima_consulta || '' %>" placeholder="Ex: Há 6 meses, clínico geral" data-custom-field-key="ultima_consulta" data-custom-field-type="texto" />
          </label>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon" style="background:#fef3f2;color:#e64b3b"><i class="fa-solid fa-people-group" aria-hidden="true"></i></span>
          Histórico familiar
        </h3>
        <div class="form-grid">
          <div class="field-wrap span-4">
            <span class="input-label">Doenças relevantes na família (pais, avós, irmãos)</span>
            <div class="checkbox-grid">
              <% [["hf_hipertensao","Hipertensão"],["hf_diabetes","Diabetes"],["hf_cancer","Câncer"],["hf_cardiopatia","Cardiopatia"],["hf_avc","AVC"],["hf_doenca_mental","Doença mental"],["hf_alcoolismo","Alcoolismo"],["hf_suicidio","Suicídio"],["hf_doencas_geneticas","Doenças genéticas"],["hf_nenhum","Não há histórico"]].forEach(function(item){ %>
                <% const hfChecked = (familia?.camposExtras?.historico_familiar || '').includes(item[0]); %>
                <label class="checkbox-option <%= hfChecked?'is-checked':'' %>">
                  <input type="checkbox" class="checkbox-input" data-checkbox-group="historico_familiar" value="<%= item[0] %>" <%= hfChecked?'checked':'' %> />
                  <span class="checkbox-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                  <span><%= item[1] %></span>
                </label>
              <% }) %>
            </div>
          </div>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon" style="background:#fff4f7;color:#c2416d"><i class="fa-solid fa-brain" aria-hidden="true"></i></span>
          Saúde mental e emocional
        </h3>
        <div class="form-grid">
          <div class="field-wrap">
            <span class="input-label">Já fez ou faz acompanhamento psicológico?</span>
            <div class="radio-group">
              <% const smPsiAtual = familia?.camposExtras?.sm_acompanhamento_psico || ''; %>
              <label class="radio-pill <%= smPsiAtual==='sim'?'is-selected':'' %>"><input type="radio" name="campoExtra_sm_acompanhamento_psico" value="sim" <%= smPsiAtual==='sim'?'checked':'' %> data-custom-field-key="sm_acompanhamento_psico" data-custom-field-type="texto" />Sim</label>
              <label class="radio-pill <%= smPsiAtual==='nao'?'is-selected':'' %>"><input type="radio" name="campoExtra_sm_acompanhamento_psico" value="nao" <%= smPsiAtual==='nao'?'checked':'' %> data-custom-field-key="sm_acompanhamento_psico" data-custom-field-type="texto" />Não</label>
              <label class="radio-pill <%= smPsiAtual==='nao_sabe'?'is-selected':'' %>"><input type="radio" name="campoExtra_sm_acompanhamento_psico" value="nao_sabe" <%= smPsiAtual==='nao_sabe'?'checked':'' %> data-custom-field-key="sm_acompanhamento_psico" data-custom-field-type="texto" />Não sabe</label>
            </div>
          </div>
          <div class="field-wrap">
            <span class="input-label">Já fez ou faz uso de medicação psiquiátrica?</span>
            <div class="radio-group">
              <% const smMedAtual = familia?.camposExtras?.sm_medicacao_psiq || ''; %>
              <label class="radio-pill <%= smMedAtual==='sim'?'is-selected':'' %>"><input type="radio" name="campoExtra_sm_medicacao_psiq" value="sim" <%= smMedAtual==='sim'?'checked':'' %> data-custom-field-key="sm_medicacao_psiq" data-custom-field-type="texto" />Sim</label>
              <label class="radio-pill <%= smMedAtual==='nao'?'is-selected':'' %>"><input type="radio" name="campoExtra_sm_medicacao_psiq" value="nao" <%= smMedAtual==='nao'?'checked':'' %> data-custom-field-key="sm_medicacao_psiq" data-custom-field-type="texto" />Não</label>
              <label class="radio-pill <%= smMedAtual==='nao_sabe'?'is-selected':'' %>"><input type="radio" name="campoExtra_sm_medicacao_psiq" value="nao_sabe" <%= smMedAtual==='nao_sabe'?'checked':'' %> data-custom-field-key="sm_medicacao_psiq" data-custom-field-type="texto" />Não sabe</label>
            </div>
          </div>
          <div class="field-wrap span-2">
            <span class="input-label">Internação psiquiátrica anterior?</span>
            <div class="radio-group">
              <% const smIntAtual = familia?.camposExtras?.sm_internacao_psiq || ''; %>
              <label class="radio-pill <%= smIntAtual==='sim'?'is-selected':'' %>"><input type="radio" name="campoExtra_sm_internacao_psiq" value="sim" <%= smIntAtual==='sim'?'checked':'' %> data-custom-field-key="sm_internacao_psiq" data-custom-field-type="texto" />Sim</label>
              <label class="radio-pill <%= smIntAtual==='nao'?'is-selected':'' %>"><input type="radio" name="campoExtra_sm_internacao_psiq" value="nao" <%= smIntAtual==='nao'?'checked':'' %> data-custom-field-key="sm_internacao_psiq" data-custom-field-type="texto" />Não</label>
              <label class="radio-pill <%= smIntAtual==='nao_sabe'?'is-selected':'' %>"><input type="radio" name="campoExtra_sm_internacao_psiq" value="nao_sabe" <%= smIntAtual==='nao_sabe'?'checked':'' %> data-custom-field-key="sm_internacao_psiq" data-custom-field-type="texto" />Não sabe</label>
            </div>
          </div>
          <div class="field-wrap span-4">
            <span class="input-label">Sintomas presentes nas últimas semanas</span>
            <div class="checkbox-grid">
              <% [["sm_tristeza","Tristeza persistente"],["sm_ansiedade","Ansiedade"],["sm_insonia","Insônia"],["sm_crises_panico","Crises de pânico"],["sm_ideacao_suicida","Ideação suicida"],["sm_irritabilidade","Irritabilidade"],["sm_falta_motivacao","Falta de motivação"],["sm_isolamento","Isolamento social"],["sm_nenhum","Nenhum"]].forEach(function(item){ %>
                <% const smChecked = (familia?.camposExtras?.sm_sintomas || '').includes(item[0]); %>
                <label class="checkbox-option <%= smChecked?'is-checked':'' %>">
                  <input type="checkbox" class="checkbox-input" data-checkbox-group="sm_sintomas" value="<%= item[0] %>" <%= smChecked?'checked':'' %> />
                  <span class="checkbox-check"><i class="fa-solid fa-check" aria-hidden="true"></i></span>
                  <span><%= item[1] %></span>
                </label>
              <% }) %>
            </div>
          </div>
          <label class="field-wrap span-2">
            <span class="input-label">Como descreve seu sono</span>
            <input class="input-control" type="text" name="campoExtra_sm_sono" value="<%= familia?.camposExtras?.sm_sono || '' %>" placeholder="Ex: 5h, fragmentado" data-custom-field-key="sm_sono" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Nível de estresse percebido (0-10)</span>
            <input class="input-control" type="number" name="campoExtra_sm_estresse" value="<%= familia?.camposExtras?.sm_estresse || '' %>" min="0" max="10" placeholder="Ex: 7" data-custom-field-key="sm_estresse" data-custom-field-type="numero" />
          </label>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon" style="background:#f0fdf4;color:#16a34a"><i class="fa-solid fa-leaf" aria-hidden="true"></i></span>
          Hábitos de vida
        </h3>
        <div class="form-grid">
          <label class="field-wrap">
            <span class="input-label">Tabagismo</span>
            <select class="input-control" name="campoExtra_tabagismo" data-custom-field-key="tabagismo" data-custom-field-type="select">
              <% const tabAtual = familia?.camposExtras?.tabagismo || ''; %>
              <option value="">Selecionar...</option>
              <option value="nao_fuma"     <%= tabAtual==='nao_fuma'?'selected':'' %>>Não fuma</option>
              <option value="ex_fumante"   <%= tabAtual==='ex_fumante'?'selected':'' %>>Ex-fumante</option>
              <option value="fumante_leve" <%= tabAtual==='fumante_leve'?'selected':'' %>>Fumante leve (&lt;10/dia)</option>
              <option value="fumante_mod"  <%= tabAtual==='fumante_mod'?'selected':'' %>>Fumante moderado</option>
              <option value="fumante_pesado" <%= tabAtual==='fumante_pesado'?'selected':'' %>>Fumante pesado (>20/dia)</option>
            </select>
          </label>
          <label class="field-wrap">
            <span class="input-label">Etilismo</span>
            <select class="input-control" name="campoExtra_etilismo" data-custom-field-key="etilismo" data-custom-field-type="select">
              <% const etAtual = familia?.camposExtras?.etilismo || ''; %>
              <option value="">Selecionar...</option>
              <option value="nao_usa"       <%= etAtual==='nao_usa'?'selected':'' %>>Não usa</option>
              <option value="social"        <%= etAtual==='social'?'selected':'' %>>Social / esporádico</option>
              <option value="moderado"      <%= etAtual==='moderado'?'selected':'' %>>Moderado</option>
              <option value="frequente"     <%= etAtual==='frequente'?'selected':'' %>>Frequente / diário</option>
              <option value="dependente"    <%= etAtual==='dependente'?'selected':'' %>>Dependente</option>
            </select>
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Outras substâncias</span>
            <select class="input-control" name="campoExtra_outras_substancias" data-custom-field-key="outras_substancias" data-custom-field-type="select">
              <% const osAtual = familia?.camposExtras?.outras_substancias || ''; %>
              <option value="nao_usa" <%= osAtual==='nao_usa'||!osAtual?'selected':'' %>>Não usa</option>
              <option value="cannabis"   <%= osAtual==='cannabis'?'selected':'' %>>Cannabis</option>
              <option value="cocaina"    <%= osAtual==='cocaina'?'selected':'' %>>Cocaína / Crack</option>
              <option value="multiplas"  <%= osAtual==='multiplas'?'selected':'' %>>Múltiplas substâncias</option>
              <option value="outra"      <%= osAtual==='outra'?'selected':'' %>>Outra</option>
            </select>
          </label>
          <label class="field-wrap">
            <span class="input-label">Atividade física</span>
            <select class="input-control" name="campoExtra_atividade_fisica" data-custom-field-key="atividade_fisica" data-custom-field-type="select">
              <% const afAtual = familia?.camposExtras?.atividade_fisica || ''; %>
              <option value="">Selecionar...</option>
              <option value="sedentario"    <%= afAtual==='sedentario'?'selected':'' %>>Sedentário</option>
              <option value="leve"          <%= afAtual==='leve'?'selected':'' %>>Leve (1-2x/semana)</option>
              <option value="moderado"      <%= afAtual==='moderado'?'selected':'' %>>Moderado (3-4x/semana)</option>
              <option value="intenso"       <%= afAtual==='intenso'?'selected':'' %>>Intenso (5+/semana)</option>
            </select>
          </label>
          <label class="field-wrap">
            <span class="input-label">Qualidade da alimentação</span>
            <select class="input-control" name="campoExtra_qualidade_alimentacao" data-custom-field-key="qualidade_alimentacao" data-custom-field-type="select">
              <% const qaAtual = familia?.camposExtras?.qualidade_alimentacao || ''; %>
              <option value="">Selecionar...</option>
              <option value="boa"       <%= qaAtual==='boa'?'selected':'' %>>Boa</option>
              <option value="regular"   <%= qaAtual==='regular'?'selected':'' %>>Regular</option>
              <option value="insuficiente" <%= qaAtual==='insuficiente'?'selected':'' %>>Insuficiente</option>
              <option value="inseguranca" <%= qaAtual==='inseguranca'?'selected':'' %>>Insegurança alimentar</option>
            </select>
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Restrições alimentares</span>
            <input class="input-control" type="text" name="campoExtra_restricoes_alimentares" value="<%= familia?.camposExtras?.restricoes_alimentares || '' %>" placeholder="Ex: lactose, glúten, vegetariano..." data-custom-field-key="restricoes_alimentares" data-custom-field-type="texto" />
          </label>
        </div>
      </div>

      <div class="form-subsection">
        <h3 class="form-subsection-title">
          <span class="form-subsection-icon" style="background:#f0f7fc;color:#1C5D85"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span>
          Trabalho e ocupação
        </h3>
        <div class="form-grid">
          <label class="field-wrap">
            <span class="input-label">Profissão</span>
            <input class="input-control" type="text" name="campoExtra_profissao" value="<%= familia?.camposExtras?.profissao || '' %>" placeholder="Ex: Auxiliar de cozinha" data-custom-field-key="profissao" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap">
            <span class="input-label">Ocupação atual</span>
            <select class="input-control" name="campoExtra_ocupacao_atual" data-custom-field-key="ocupacao_atual" data-custom-field-type="select">
              <% const ocAtual = familia?.camposExtras?.ocupacao_atual || ''; %>
              <option value="">Selecionar...</option>
              <option value="empregado_clt"   <%= ocAtual==='empregado_clt'?'selected':'' %>>Empregado (CLT)</option>
              <option value="autonomo"        <%= ocAtual==='autonomo'?'selected':'' %>>Autônomo / Informal</option>
              <option value="servidor_pub"    <%= ocAtual==='servidor_pub'?'selected':'' %>>Servidor público</option>
              <option value="desempregado"    <%= ocAtual==='desempregado'?'selected':'' %>>Desempregado</option>
              <option value="aposentado"      <%= ocAtual==='aposentado'?'selected':'' %>>Aposentado / Pensionista</option>
              <option value="estudante"       <%= ocAtual==='estudante'?'selected':'' %>>Estudante</option>
              <option value="inativo"         <%= ocAtual==='inativo'?'selected':'' %>>Inativo / Sem renda</option>
            </select>
          </label>
          <label class="field-wrap span-2">
            <span class="input-label">Carga horária semanal</span>
            <input class="input-control" type="text" name="campoExtra_carga_horaria" value="<%= familia?.camposExtras?.carga_horaria || '' %>" placeholder="Ex: 44h" data-custom-field-key="carga_horaria" data-custom-field-type="texto" />
          </label>
          <label class="field-wrap span-4">
            <span class="input-label">Doenças ocupacionais ou afastamentos</span>
