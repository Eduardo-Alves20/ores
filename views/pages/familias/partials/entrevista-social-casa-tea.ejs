    <label class="field-wrap"><span class="input-label">Possui cartao SUS?</span><input class="input-control" type="text" name="campoExtra_casatea_cartao_sus" value="<%= familia?.camposExtras?.casatea_cartao_sus || '' %>" placeholder="Sim / Nao" data-custom-field-key="casatea_cartao_sus" data-custom-field-type="texto" /></label>
