<div class="form-subsection">
  <h3 class="form-subsection-title"><span class="form-subsection-icon"><i class="fa-solid fa-house-flag" aria-hidden="true"></i></span>4. Condicoes de moradia</h3>
  <div class="form-grid">
    <label class="field-wrap span-4"><span class="input-label">Endereco completo</span><textarea class="input-control textarea-control" name="campoExtra_casatea_moradia_endereco" rows="2" data-custom-field-key="casatea_moradia_endereco" data-custom-field-type="textarea"><%= familia?.camposExtras?.casatea_moradia_endereco || '' %></textarea></label>
    <label class="field-wrap"><span class="input-label">Condicao de moradia</span><input class="input-control" type="text" name="campoExtra_casatea_moradia_condicao" value="<%= familia?.camposExtras?.casatea_moradia_condicao || '' %>" placeholder="Proprio / Alugado / Programa social / Ocupacao / Cedido" data-custom-field-key="casatea_moradia_condicao" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">No de comodos</span><input class="input-control" type="text" name="campoExtra_casatea_moradia_comodos" value="<%= familia?.camposExtras?.casatea_moradia_comodos || '' %>" data-custom-field-key="casatea_moradia_comodos" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">No de pessoas no domicilio</span><input class="input-control" type="text" name="campoExtra_casatea_moradia_pessoas" value="<%= familia?.camposExtras?.casatea_moradia_pessoas || '' %>" data-custom-field-key="casatea_moradia_pessoas" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Saneamento basico (banheiro/luz/agua/esgoto)</span><input class="input-control" type="text" name="campoExtra_casatea_moradia_saneamento" value="<%= familia?.camposExtras?.casatea_moradia_saneamento || '' %>" data-custom-field-key="casatea_moradia_saneamento" data-custom-field-type="texto" /></label>
    <label class="field-wrap span-2"><span class="input-label">Entorno/Acesso (transporte/area ruidosa/barreiras arquitetonicas)</span><input class="input-control" type="text" name="campoExtra_casatea_moradia_entorno" value="<%= familia?.camposExtras?.casatea_moradia_entorno || '' %>" data-custom-field-key="casatea_moradia_entorno" data-custom-field-type="texto" /></label>
    <label class="field-wrap span-2"><span class="input-label">Situacao de risco no territorio (violencia/trafico/area de risco ambiental/nenhum)</span><input class="input-control" type="text" name="campoExtra_casatea_moradia_risco_territorio" value="<%= familia?.camposExtras?.casatea_moradia_risco_territorio || '' %>" data-custom-field-key="casatea_moradia_risco_territorio" data-custom-field-type="texto" /></label>
  </div>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title"><span class="form-subsection-icon"><i class="fa-solid fa-people-roof" aria-hidden="true"></i></span>5. Composicao do nucleo familiar</h3>
  <p style="font-size:0.78rem;color:var(--muted);margin:0 0 12px">Nome completo, parentesco, idade, escolaridade/ocupacao e renda mensal.</p>
  <div class="cf-table">
    <div class="cf-table-header"><span>NOME</span><span>PARENTESCO</span><span>IDADE</span><span>ESCOLARIDADE</span><span>OCUPACAO</span><span>RENDA</span><span></span></div>
    <div id="cf-rows"></div>
  </div>
  <button type="button" class="cf-add-btn" id="cf-add-btn"><i class="fa-solid fa-plus" aria-hidden="true"></i> Adicionar membro do nucleo</button>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title"><span class="form-subsection-icon"><i class="fa-solid fa-hand-holding-heart" aria-hidden="true"></i></span>6. Situacao socioeconomica e beneficios</h3>
  <div class="form-grid">
    <div class="field-wrap"><span class="input-label">Cadastrado no CadUnico?</span><div class="radio-group"><% const cad = familia?.camposExtras?.casatea_cadunico || ''; %><label class="radio-pill <%= cad==='sim'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_cadunico" value="sim" <%= cad==='sim'?'checked':'' %> data-custom-field-key="casatea_cadunico" data-custom-field-type="texto" />Sim</label><label class="radio-pill <%= cad==='nao'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_cadunico" value="nao" <%= cad==='nao'?'checked':'' %> data-custom-field-key="casatea_cadunico" data-custom-field-type="texto" />Nao</label></div></div>
    <label class="field-wrap span-3"><span class="input-label">Acesso a beneficios sociais (BPC/LOAS, Bolsa Familia, Minha Casa Minha Vida, outros)</span><input class="input-control" type="text" name="campoExtra_casatea_beneficios" value="<%= familia?.camposExtras?.casatea_beneficios || '' %>" data-custom-field-key="casatea_beneficios" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Renda familiar mensal aproximada</span><input class="input-control" type="text" id="renda_familiar_total_input" name="campoExtra_renda_familiar" value="<%= familia?.camposExtras?.renda_familiar || '' %>" data-custom-field-key="renda_familiar" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Renda per capita (calculada)</span><input class="input-control" type="text" id="renda_per_capita_display" placeholder="R$ -" readonly tabindex="-1" /></label>
    <label class="field-wrap span-2"><span class="input-label">Principais fontes de renda</span><input class="input-control" type="text" name="campoExtra_casatea_fontes_renda" value="<%= familia?.camposExtras?.casatea_fontes_renda || '' %>" data-custom-field-key="casatea_fontes_renda" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Gasto mensal com deficiencia (remedios/dietas)</span><input class="input-control" type="text" name="campoExtra_casatea_gasto_deficiencia" value="<%= familia?.camposExtras?.casatea_gasto_deficiencia || '' %>" data-custom-field-key="casatea_gasto_deficiencia" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Despesas fixas principais</span><input class="input-control" type="text" name="campoExtra_casatea_despesas_fixas" value="<%= familia?.camposExtras?.casatea_despesas_fixas || '' %>" placeholder="Aluguel / Alimentacao / Medicamentos / Transporte" data-custom-field-key="casatea_despesas_fixas" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Inseguranca alimentar</span><input class="input-control" type="text" name="campoExtra_casatea_inseguranca_alimentar" value="<%= familia?.camposExtras?.casatea_inseguranca_alimentar || '' %>" placeholder="Sim / Nao / As vezes" data-custom-field-key="casatea_inseguranca_alimentar" data-custom-field-type="texto" /></label>
  </div>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title"><span class="form-subsection-icon"><i class="fa-solid fa-stethoscope" aria-hidden="true"></i></span>7. Saude e acompanhamento</h3>
  <div class="form-grid">
    <label class="field-wrap"><span class="input-label">Realiza tratamento em unidade de saude?</span><input class="input-control" type="text" name="campoExtra_casatea_tratamento_unidade_saude" value="<%= familia?.camposExtras?.casatea_tratamento_unidade_saude || '' %>" placeholder="Sim / Nao" data-custom-field-key="casatea_tratamento_unidade_saude" data-custom-field-type="texto" /></label>
