    <label class="field-wrap span-2"><span class="input-label">Tecnico responsavel</span><input class="input-control" type="text" name="campoExtra_casatea_tecnico_responsavel" value="<%= familia?.camposExtras?.casatea_tecnico_responsavel || '' %>" data-custom-field-key="casatea_tecnico_responsavel" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Local do atendimento</span><input class="input-control" type="text" name="campoExtra_casatea_local_atendimento" value="<%= familia?.camposExtras?.casatea_local_atendimento || '' %>" data-custom-field-key="casatea_local_atendimento" data-custom-field-type="texto" /></label>
    <div class="field-wrap"><span class="input-label">Tipo de atendimento</span><div class="radio-group"><% const caTipo = familia?.camposExtras?.casatea_tipo_atendimento || ''; %><label class="radio-pill <%= caTipo==='inicial'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_tipo_atendimento" value="inicial" <%= caTipo==='inicial'?'checked':'' %> data-custom-field-key="casatea_tipo_atendimento" data-custom-field-type="texto" />Inicial</label><label class="radio-pill <%= caTipo==='acompanhamento'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_tipo_atendimento" value="acompanhamento" <%= caTipo==='acompanhamento'?'checked':'' %> data-custom-field-key="casatea_tipo_atendimento" data-custom-field-type="texto" />Acompanhamento</label></div></div>
    <div class="field-wrap span-2"><span class="input-label">Forma de acesso ao servico</span><div class="radio-group"><% const caAcesso = familia?.camposExtras?.casatea_forma_acesso || ''; %><label class="radio-pill <%= caAcesso==='espontanea'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_forma_acesso" value="espontanea" <%= caAcesso==='espontanea'?'checked':'' %> data-custom-field-key="casatea_forma_acesso" data-custom-field-type="texto" />Demanda espontanea</label><label class="radio-pill <%= caAcesso==='encaminhamento'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_forma_acesso" value="encaminhamento" <%= caAcesso==='encaminhamento'?'checked':'' %> data-custom-field-key="casatea_forma_acesso" data-custom-field-type="texto" />Encaminhamento</label><label class="radio-pill <%= caAcesso==='busca_ativa'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_forma_acesso" value="busca_ativa" <%= caAcesso==='busca_ativa'?'checked':'' %> data-custom-field-key="casatea_forma_acesso" data-custom-field-type="texto" />Busca ativa</label></div></div>
    <label class="field-wrap span-2"><span class="input-label">Origem do encaminhamento (CRAS, CREAS, Saude, Escola, Conselho Tutelar, Outros)</span><input class="input-control" type="text" name="campoExtra_casatea_origem_encaminhamento" value="<%= familia?.camposExtras?.casatea_origem_encaminhamento || '' %>" data-custom-field-key="casatea_origem_encaminhamento" data-custom-field-type="texto" /></label>
  </div>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title"><span class="form-subsection-icon"><i class="fa-solid fa-id-card" aria-hidden="true"></i></span>2. Dados do responsavel</h3>
  <div class="form-grid">
    <label class="field-wrap span-2"><span class="input-label">Nome do responsavel (mae/pai/cuidador)</span><input class="input-control" type="text" name="campoExtra_casatea_resp_nome" value="<%= familia?.camposExtras?.casatea_resp_nome || '' %>" data-custom-field-key="casatea_resp_nome" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Data de nascimento</span><input class="input-control" type="date" name="campoExtra_casatea_resp_nascimento" value="<%= familia?.camposExtras?.casatea_resp_nascimento || '' %>" data-custom-field-key="casatea_resp_nascimento" data-custom-field-type="data" /></label>
    <label class="field-wrap"><span class="input-label">Genero</span><input class="input-control" type="text" name="campoExtra_casatea_resp_genero" value="<%= familia?.camposExtras?.casatea_resp_genero || '' %>" data-custom-field-key="casatea_resp_genero" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">CPF</span><input class="input-control" type="text" name="campoExtra_casatea_resp_cpf" value="<%= familia?.camposExtras?.casatea_resp_cpf || '' %>" data-custom-field-key="casatea_resp_cpf" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Estado civil</span><input class="input-control" type="text" name="campoExtra_casatea_resp_estado_civil" value="<%= familia?.camposExtras?.casatea_resp_estado_civil || '' %>" data-custom-field-key="casatea_resp_estado_civil" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">NIS</span><input class="input-control" type="text" name="campoExtra_casatea_resp_nis" value="<%= familia?.camposExtras?.casatea_resp_nis || '' %>" data-custom-field-key="casatea_resp_nis" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Telefone</span><input class="input-control" type="text" name="campoExtra_casatea_resp_telefone" value="<%= familia?.camposExtras?.casatea_resp_telefone || '' %>" data-custom-field-key="casatea_resp_telefone" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Telefone de emergencia</span><input class="input-control" type="text" name="campoExtra_casatea_resp_tel_emergencia" value="<%= familia?.camposExtras?.casatea_resp_tel_emergencia || '' %>" data-custom-field-key="casatea_resp_tel_emergencia" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Escolaridade</span><input class="input-control" type="text" name="campoExtra_casatea_resp_escolaridade" value="<%= familia?.camposExtras?.casatea_resp_escolaridade || '' %>" data-custom-field-key="casatea_resp_escolaridade" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Profissao/Ocupacao</span><input class="input-control" type="text" name="campoExtra_casatea_resp_ocupacao" value="<%= familia?.camposExtras?.casatea_resp_ocupacao || '' %>" data-custom-field-key="casatea_resp_ocupacao" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Autodeclaracao (raca/cor)</span><input class="input-control" type="text" name="campoExtra_casatea_resp_raca_cor" value="<%= familia?.camposExtras?.casatea_resp_raca_cor || '' %>" data-custom-field-key="casatea_resp_raca_cor" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Naturalidade</span><input class="input-control" type="text" name="campoExtra_casatea_resp_naturalidade" value="<%= familia?.camposExtras?.casatea_resp_naturalidade || '' %>" data-custom-field-key="casatea_resp_naturalidade" data-custom-field-type="texto" /></label>
  </div>
</div>

<div class="form-subsection">
  <h3 class="form-subsection-title"><span class="form-subsection-icon"><i class="fa-solid fa-child-reaching" aria-hidden="true"></i></span>3. Dados da crianca/adolescente</h3>
  <div class="form-grid">
    <label class="field-wrap span-2"><span class="input-label">Nome completo</span><input class="input-control" type="text" name="campoExtra_casatea_assist_nome" value="<%= familia?.camposExtras?.casatea_assist_nome || '' %>" data-custom-field-key="casatea_assist_nome" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Data de nascimento</span><input class="input-control" type="date" name="campoExtra_casatea_assist_nascimento" value="<%= familia?.camposExtras?.casatea_assist_nascimento || '' %>" data-custom-field-key="casatea_assist_nascimento" data-custom-field-type="data" /></label>
    <label class="field-wrap"><span class="input-label">Genero</span><input class="input-control" type="text" name="campoExtra_casatea_assist_genero" value="<%= familia?.camposExtras?.casatea_assist_genero || '' %>" data-custom-field-key="casatea_assist_genero" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">CPF</span><input class="input-control" type="text" name="campoExtra_casatea_assist_cpf" value="<%= familia?.camposExtras?.casatea_assist_cpf || '' %>" data-custom-field-key="casatea_assist_cpf" data-custom-field-type="texto" /></label>
    <div class="field-wrap"><span class="input-label">Documentacao civil completa?</span><div class="radio-group"><% const dcc = familia?.camposExtras?.casatea_doc_civil_completa || ''; %><label class="radio-pill <%= dcc==='sim'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_doc_civil_completa" value="sim" <%= dcc==='sim'?'checked':'' %> data-custom-field-key="casatea_doc_civil_completa" data-custom-field-type="texto" />Sim</label><label class="radio-pill <%= dcc==='nao'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_doc_civil_completa" value="nao" <%= dcc==='nao'?'checked':'' %> data-custom-field-key="casatea_doc_civil_completa" data-custom-field-type="texto" />Nao</label></div></div>
    <div class="field-wrap"><span class="input-label">Possui CIPTEA?</span><div class="radio-group"><% const cip = familia?.camposExtras?.casatea_ciptea || ''; %><label class="radio-pill <%= cip==='sim'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_ciptea" value="sim" <%= cip==='sim'?'checked':'' %> data-custom-field-key="casatea_ciptea" data-custom-field-type="texto" />Sim</label><label class="radio-pill <%= cip==='nao'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_ciptea" value="nao" <%= cip==='nao'?'checked':'' %> data-custom-field-key="casatea_ciptea" data-custom-field-type="texto" />Nao</label><label class="radio-pill <%= cip==='tramite'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_ciptea" value="tramite" <%= cip==='tramite'?'checked':'' %> data-custom-field-key="casatea_ciptea" data-custom-field-type="texto" />Em tramite</label></div></div>
    <label class="field-wrap"><span class="input-label">Escolaridade</span><input class="input-control" type="text" name="campoExtra_casatea_assist_escolaridade" value="<%= familia?.camposExtras?.casatea_assist_escolaridade || '' %>" data-custom-field-key="casatea_assist_escolaridade" data-custom-field-type="texto" /></label>
    <label class="field-wrap span-2"><span class="input-label">Escolarizacao (Matriculado/Frequenta AEE/Possui PEI)</span><input class="input-control" type="text" name="campoExtra_casatea_escolarizacao" value="<%= familia?.camposExtras?.casatea_escolarizacao || '' %>" data-custom-field-key="casatea_escolarizacao" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Instituicao de ensino</span><input class="input-control" type="text" name="campoExtra_casatea_instituicao_ensino" value="<%= familia?.camposExtras?.casatea_instituicao_ensino || '' %>" data-custom-field-key="casatea_instituicao_ensino" data-custom-field-type="texto" /></label>
    <div class="field-wrap"><span class="input-label">Possui mediador/cuidador escolar?</span><div class="radio-group"><% const med = familia?.camposExtras?.casatea_mediador_escolar || ''; %><label class="radio-pill <%= med==='sim'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_mediador_escolar" value="sim" <%= med==='sim'?'checked':'' %> data-custom-field-key="casatea_mediador_escolar" data-custom-field-type="texto" />Sim</label><label class="radio-pill <%= med==='nao'?'is-selected':'' %>"><input type="radio" name="campoExtra_casatea_mediador_escolar" value="nao" <%= med==='nao'?'checked':'' %> data-custom-field-key="casatea_mediador_escolar" data-custom-field-type="texto" />Nao</label></div></div>
  </div>
