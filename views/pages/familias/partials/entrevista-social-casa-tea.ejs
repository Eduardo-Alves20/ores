    <label class="field-wrap span-2"><span class="input-label">Quais profissionais (psicologo, fono, TO, outros)</span><input class="input-control" type="text" name="campoExtra_casatea_profissionais" value="<%= familia?.camposExtras?.casatea_profissionais || '' %>" data-custom-field-key="casatea_profissionais" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Diagnostico (TEA nivel 1/2/3 ou outros)</span><input class="input-control" type="text" name="campoExtra_casatea_diagnostico" value="<%= familia?.camposExtras?.casatea_diagnostico || '' %>" data-custom-field-key="casatea_diagnostico" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Possui laudo?</span><input class="input-control" type="text" name="campoExtra_casatea_possui_laudo" value="<%= familia?.camposExtras?.casatea_possui_laudo || '' %>" placeholder="Sim / Nao / Em investigacao" data-custom-field-key="casatea_possui_laudo" data-custom-field-type="texto" /></label>
    <label class="field-wrap"><span class="input-label">Diagnostico/CID</span><input class="input-control" type="text" name="campoExtra_casatea_cid" value="<%= familia?.camposExtras?.casatea_cid || '' %>" data-custom-field-key="casatea_cid" data-custom-field-type="texto" /></label>
